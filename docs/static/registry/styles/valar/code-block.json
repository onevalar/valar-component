		{
			"content": "<script lang=\"ts\" module>\n\timport { tv, type VariantProps } from \"tailwind-variants\";\n\n\texport const codeBlockVariants = tv({\n\t\tbase: \"rounded-lg text-sm data-[size=sm]:text-xs group/code-block relative flex w-full min-w-0 flex-col overflow-hidden\",\n\t\tvariants: {\n\t\t\tvariant: {\n\t\t\t\tdefault: \"border border-input text-foreground dark:bg-input/30\",\n\t\t\t\tdestructive: \"border border-destructive/30 text-destructive dark:border-destructive/40\",\n\t\t\t},\n\t\t},\n\t\tdefaultVariants: {\n\t\t\tvariant: \"default\",\n\t\t},\n\t});\n\n\texport type CodeBlockVariant = VariantProps<typeof codeBlockVariants>[\"variant\"];\n\texport type CodeBlockSize = \"default\" | \"sm\";\n\texport type CodeBlockAppearance = \"issue\" | \"agent\";\n</script>\n\n<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tvariant = \"default\",\n\t\tsize = \"default\",\n\t\tappearance,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\tvariant?: CodeBlockVariant;\n\t\tsize?: CodeBlockSize;\n\t\tappearance?: CodeBlockAppearance;\n\t} = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"code-block\"\n\tdata-variant={variant}\n\tdata-size={size}\n\tdata-appearance={appearance}\n\tclass={cn(codeBlockVariants({ variant }), appearance && \"rounded-[6px] text-xs/5 data-[variant=default]:border-[0.5px] data-[variant=default]:border-[lch(91.9%_0_282)] data-[variant=default]:bg-white dark:data-[variant=default]:border-[lch(16.793%_1.93_272)] dark:data-[variant=default]:bg-[lch(9.232%_.85_272)] dark:data-[variant=default]:text-[lch(90.451%_1.2_272)]\", className)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
