			"content": "<script lang=\"ts\" module>\n\timport { tv, type VariantProps } from \"tailwind-variants\";\n\n\texport const codeBlockLineVariants = tv({\n\t\tbase: \"-mx-3 px-3 in-data-numbered:gap-x-3 before:min-w-6 before:text-end before:text-muted-foreground after:start-1 after:text-muted-foreground group-data-[size=sm]/code-block:-mx-2.5 group-data-[size=sm]/code-block:px-2.5 group-data-[appearance]/code-block:ms-0 group-data-[appearance]/code-block:-me-4 group-data-[appearance]/code-block:ps-0 group-data-[appearance]/code-block:pe-4 group-data-[appearance]/code-block:in-data-numbered:gap-x-0 group-data-[appearance]/code-block:before:min-w-12.5 group-data-[appearance]/code-block:before:pe-3 relative block min-h-lh after:absolute after:top-0 after:select-none in-data-numbered:col-span-2 in-data-numbered:grid in-data-numbered:grid-cols-subgrid in-data-numbered:[counter-increment:line] in-data-numbered:before:content-[counter(line)] in-data-numbered:before:select-none in-data-numbered:supports-[content:counter(line)_/_'']:before:content-[counter(line)_/_'']\",\n\t\tvariants: {\n\t\t\tvariant: {\n\t\t\t\tdefault: \"\",\n\t\t\t\tadded: \"bg-muted after:content-['+']\",\n\t\t\t\tremoved: \"bg-destructive/10 after:text-destructive after:content-['−']\",\n\t\t\t\thighlighted: \"bg-muted\",\n\t\t\t},\n\t\t},\n\t\tdefaultVariants: {\n\t\t\tvariant: \"default\",\n\t\t},\n\t});\n\n\texport type CodeBlockLineVariant = VariantProps<typeof codeBlockLineVariants>[\"variant\"];\n\n\t// One highlighted token, such as one returned by `useHighlightedCode`.\n\texport type CodeBlockLineToken = {\n\t\tcontent: string;\n\t\tstyle?: string;\n\t\tclass?: string;\n\t};\n</script>\n\n<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tvariant = \"default\",\n\t\tcode,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLSpanElement>> & {\n\t\tvariant?: CodeBlockLineVariant;\n\t\t/** The line as plain text, or as highlighted tokens. When it is set, `children` is ignored. */\n\t\tcode?: string | CodeBlockLineToken[];\n\t} = $props();\n\n\tconst newline = \"\\n\";\n</script>\n\n<!-- An empty line holds a newline so copying a selection keeps blank lines. -->\n<span\n\tbind:this={ref}\n\tdata-slot=\"code-block-line\"\n\tdata-variant={variant}\n\tclass={cn(codeBlockLineVariants({ variant }), className)}\n\t{...restProps}\n>\n\t<span data-slot=\"code-block-line-content\" class=\"min-w-0\">\n\t\t{#if typeof code === \"string\"}\n\t\t\t{code || newline}\n\t\t{:else if code?.length}\n\t\t\t{#each code as token, index (index)}\n\t\t\t\t<span style={token.style} class={token.class}>{token.content}</span>\n\t\t\t{/each}\n\t\t{:else if code}\n\t\t\t{newline}\n\t\t{:else if children}\n\t\t\t{@render children()}\n\t\t{:else}\n\t\t\t{newline}\n\t\t{/if}\n\t</span>\n</span>\n",
			"type": "registry:file",
			"target": "code-block/code-block-line.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"code-block-title\"\n\tclass={cn(\n\t\t\"font-sans text-sm font-medium text-foreground group-data-[variant=destructive]/code-block:text-destructive *:[svg]:me-1.5 [&_svg:not([class*='size-'])]:size-3.5 group-data-[size=sm]/code-block:text-xs min-w-0 truncate [&_svg]:pointer-events-none [&_svg]:inline-block [&_svg]:align-middle\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
