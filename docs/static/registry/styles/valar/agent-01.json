			"content": "<script lang=\"ts\">\n\timport * as Bubble from \"$UI$/bubble/index.js\";\n\timport * as Marker from \"$UI$/marker/index.js\";\n\timport * as Message from \"$UI$/message/index.js\";\n\timport * as Trace from \"$UI$/trace/index.js\";\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { Button } from \"$UI$/button/index.js\";\n\timport type { Turn } from \"./data.js\";\n\n\tlet { turn, chinese }: { turn: Turn; chinese: boolean } = $props();\n\tconst text = (zh: string, en: string) => (chinese ? zh : en);\n\tlet copyResult = $state<\"ok\" | \"failed\">();\n\tconst copyLabel = $derived(text(\"复制回复\", \"Copy reply\"));\n\tconst toolLabel = $derived(\n\t\tturn.tool === \"file\"\n\t\t\t? turn.toolDone\n\t\t\t\t? text(\"已检查附件\", \"Checked attachments\")\n\t\t\t\t: text(\"正在检查附件…\", \"Checking attachments…\")\n\t\t\t: turn.toolDone\n\t\t\t\t? text(\"已搜索示例问题\", \"Searched sample issues\")\n\t\t\t\t: text(\"正在搜索示例问题…\", \"Searching sample issues…\")\n\t);\n\tconst stopped = $derived(turn.phase === \"stopped\");\n\n\tasync function copyReply() {\n\t\tconst content = [\n\t\t\t...turn.reply,\n\t\t\t...turn.checklist.map((item, index) => index + 1 + \". \" + item),\n\t\t];\n\t\ttry {\n\t\t\tawait navigator.clipboard.writeText(content.join(\"\\n\\n\"));\n\t\t\tcopyResult = \"ok\";\n\t\t} catch {\n\t\t\tcopyResult = \"failed\";\n\t\t}\n\t}\n</script>\n\n<Message.Root role=\"group\" aria-label={text(\"Agent 回复\", \"Agent reply\")}>\n\t<Message.Content class=\"gap-2\">\n\t\t{#if turn.phase === \"thinking\"}\n\t\t\t<Marker.Root class=\"text-[13px] text-muted-foreground motion-safe:animate-pulse\">\n\t\t\t\t{text(\"思考中…\", \"Thinking…\")}\n\t\t\t</Marker.Root>\n\t\t{/if}\n\t\t{#if turn.tool && turn.phase !== \"thinking\" && (!stopped || turn.toolDone)}\n\t\t\t<Trace.Root class=\"motion-reduce:[&_[data-slot=trace-collapsible-content]]:animate-none\">\n\t\t\t\t<Trace.Collapsible>\n\t\t\t\t\t<Trace.CollapsibleTrigger\n\t\t\t\t\t\tclass=\"rounded-sm py-0.5 text-[13px] focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-ring\"\n\t\t\t\t\t>\n\t\t\t\t\t\t{#if turn.workedSeconds}\n\t\t\t\t\t\t\t{text(\n\t\t\t\t\t\t\t\t\"已处理 \" + turn.workedSeconds + \" 秒\",\n\t\t\t\t\t\t\t\t\"Worked for \" +\n\t\t\t\t\t\t\t\t\tturn.workedSeconds +\n\t\t\t\t\t\t\t\t\t(turn.workedSeconds === 1 ? \" second\" : \" seconds\")\n\t\t\t\t\t\t\t)}\n\t\t\t\t\t\t{:else}\n\t\t\t\t\t\t\t{text(\"处理中…\", \"Working…\")}\n\t\t\t\t\t\t{/if}\n\t\t\t\t\t</Trace.CollapsibleTrigger>\n\t\t\t\t\t<Trace.CollapsibleContent class=\"ps-2 pt-1 motion-reduce:animate-none\">\n\t\t\t\t\t\t<Trace.Line status={turn.toolDone ? undefined : \"running\"}>\n\t\t\t\t\t\t\t<Trace.Icon>\n\t\t\t\t\t\t\t\t{#if turn.tool === \"file\"}\n\t\t\t\t\t\t\t\t\t<IconPlaceholder\n\t\t\t\t\t\t\t\t\t\tlucide=\"FileIcon\"\n\t\t\t\t\t\t\t\t\t\ttabler=\"IconFile\"\n\t\t\t\t\t\t\t\t\t\thugeicons=\"File01Icon\"\n\t\t\t\t\t\t\t\t\t\tphosphor=\"FileIcon\"\n\t\t\t\t\t\t\t\t\t\tremixicon=\"RiFileLine\"\n\t\t\t\t\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t{:else}\n\t\t\t\t\t\t\t\t\t<IconPlaceholder\n\t\t\t\t\t\t\t\t\t\tlucide=\"SearchIcon\"\n\t\t\t\t\t\t\t\t\t\ttabler=\"IconSearch\"\n\t\t\t\t\t\t\t\t\t\thugeicons=\"Search01Icon\"\n\t\t\t\t\t\t\t\t\t\tphosphor=\"MagnifyingGlassIcon\"\n\t\t\t\t\t\t\t\t\t\tremixicon=\"RiSearchLine\"\n\t\t\t\t\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t</Trace.Icon>\n\t\t\t\t\t\t\t<Trace.Title>{toolLabel}</Trace.Title>\n\t\t\t\t\t\t\t{#if turn.toolDone && turn.tool === \"search\"}\n\t\t\t\t\t\t\t\t<Trace.Description>{text(\"评审清单\", \"Review checklist\")}</Trace.Description>\n\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t</Trace.Line>\n\t\t\t\t\t</Trace.CollapsibleContent>\n\t\t\t\t</Trace.Collapsible>\n\t\t\t</Trace.Root>\n\t\t{/if}\n\t\t{#if turn.reply.length}\n\t\t\t<Bubble.Root variant=\"ghost\" class=\"w-full\">\n\t\t\t\t<Bubble.Content class=\"w-full border-0 text-[15px] leading-6\">\n\t\t\t\t\t{#each turn.reply as paragraph, index (index)}\n\t\t\t\t\t\t<p class=\"mb-3 last:mb-0\">{paragraph}</p>\n\t\t\t\t\t{/each}\n\t\t\t\t\t{#if turn.checklist.length}\n\t\t\t\t\t\t<ol class=\"list-decimal space-y-1 ps-6\">\n\t\t\t\t\t\t\t{#each turn.checklist as item, index (index)}\n\t\t\t\t\t\t\t\t<li>{item}</li>\n\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t</ol>\n\t\t\t\t\t{/if}\n\t\t\t\t</Bubble.Content>\n\t\t\t</Bubble.Root>\n\t\t{/if}\n\t\t{#if stopped}<p role=\"status\" class=\"text-xs text-muted-foreground\">\n\t\t\t\t{text(\"已停止回复\", \"Response stopped\")}\n\t\t\t</p>{/if}\n\t\t{#if turn.phase === \"done\" || (stopped && turn.reply.length)}\n\t\t\t<Message.Footer class=\"flex items-center gap-1\">\n\t\t\t\t<Button\n\t\t\t\t\tsize=\"icon-xs\"\n\t\t\t\t\tvariant=\"ghost\"\n\t\t\t\t\taria-label={copyLabel}\n\t\t\t\t\ttitle={copyLabel}\n\t\t\t\t\tonclick={copyReply}\n\t\t\t\t>\n\t\t\t\t\t<IconPlaceholder\n\t\t\t\t\t\tlucide=\"CopyIcon\"\n\t\t\t\t\t\ttabler=\"IconCopy\"\n\t\t\t\t\t\thugeicons=\"Copy01Icon\"\n\t\t\t\t\t\tphosphor=\"CopyIcon\"\n\t\t\t\t\t\tremixicon=\"RiFileCopyLine\"\n\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t/>\n\t\t\t\t</Button>\n\t\t\t\t{#if copyResult}<span role=\"status\" class=\"text-xs text-muted-foreground\"\n\t\t\t\t\t\t>{copyResult === \"ok\"\n\t\t\t\t\t\t\t? text(\"已复制\", \"Copied\")\n\t\t\t\t\t\t\t: text(\"无法复制\", \"Could not copy\")}</span\n\t\t\t\t\t>{/if}\n\t\t\t</Message.Footer>\n\t\t{/if}\n\t</Message.Content>\n</Message.Root>\n",
			"type": "registry:page",
			"target": "agent-01/agent-reply.svelte"
		},
		{
			"content": "export const examples = [\n\t{\n\t\tid: \"project\",\n\t\ttitle: [\"创建新项目\", \"Create a new project\"],\n\t\tdescription: [\"把一个想法整理成范围明确的项目\", \"Turn an idea into a well-scoped project\"],\n\t\treply: [\n\t\t\t\"先从预期结果开始。这个项目想解决什么问题，谁会使用它？\",\n\t\t\t\"Let's start with the outcome. What problem should this project solve, and who will use it?\",\n\t\t],\n\t\tfollowUp: [\n\t\t\t\"给我一个目标和大致时间，我可以把它整理成范围、里程碑和验收标准。\",\n\t\t\t\"Share a goal and rough timeline, and I can lay out scope, milestones, and acceptance criteria.\",\n\t\t],\n\t},\n\t{\n\t\tid: \"research\",\n\t\ttitle: [\"研究一个主题\", \"Research a topic\"],\n\t\tdescription: [\"在待办问题中查找相关信息\", \"Research a topic across the issue backlog\"],\n\t\treply: [\n\t\t\t\"你想查找哪个功能、问题或关键词？可以指定一个团队，也可以查看整个工作区。\",\n\t\t\t\"What feature, problem, or keyword should I look for? You can specify a team or search across the workspace.\",\n\t\t],\n\t\tfollowUp: [\n\t\t\t\"我可以按主题归纳结果，并指出需要进一步验证的地方。\",\n\t\t\t\"I can group the results by theme and flag what needs further verification.\",\n\t\t],\n\t},\n\t{\n\t\tid: \"team\",\n\t\ttitle: [\"建立新团队\", \"Set up a new team\"],\n\t\tdescription: [\"创建符合协作方式的团队\", \"Create a team that matches how you work\"],\n\t\treply: [\n\t\t\t\"这个团队负责什么？先定下成员、职责和工作流，再配置状态与项目。\",\n\t\t\t\"What will this team own? Start with members, responsibilities, and workflow, then set up statuses and projects.\",\n\t\t],\n\t\tfollowUp: [\n\t\t\t\"如果你描述目前的协作方式，我可以给出一份可讨论的团队设置草案。\",\n\t\t\t\"Describe how the team collaborates today and I can outline a proposed setup.\",\n\t\t],\n\t},\n] as const;\n\nexport type Example = (typeof examples)[number];\nexport type ChatFile = {\n\tid: number;\n\tfile: File;\n\tstate: \"uploading\" | \"done\" | \"error\";\n\turl?: string;\n};\nexport type Draft = { text: string; files: ChatFile[] };\nexport type Turn = {\n\tid: string;\n\tprompt: string;\n\texample?: Example;\n\tfiles: ChatFile[];\n\tphase: \"thinking\" | \"working\" | \"streaming\" | \"done\" | \"stopped\";\n\ttool: \"search\" | \"file\" | null;\n\ttoolDone: boolean;\n\tworkedSeconds?: number;\n\treply: string[];\n\tchecklist: string[];\n};\nexport type Chat = { id: string; title: string; turns: Turn[]; label: string; date?: string };\ntype Copy = (zh: string, en: string) => string;\n\nexport const newDraft = (): Draft => ({ text: \"\", files: [] });\n\nexport function replyFor(text: Copy, example?: Example, files: ChatFile[] = []) {\n\tif (example) {\n\t\treturn {\n\t\t\tparagraphs: [\n\t\t\t\ttext(example.reply[0], example.reply[1]),\n\t\t\t\ttext(example.followUp[0], example.followUp[1]),\n\t\t\t],\n\t\t\tchecklist: [],\n\t\t};\n\t}\n\treturn {\n\t\tparagraphs: [\n\t\t\tfiles.length\n\t\t\t\t? text(\n\t\t\t\t\t\t\"已收到附件。下面是一份界面评审清单，可以用来逐项检查这个场景。\",\n\t\t\t\t\t\t\"The attachment is ready. Here is a checklist for reviewing this interface.\"\n\t\t\t\t\t)\n\t\t\t\t: text(\n\t\t\t\t\t\t\"这里有一份界面评审清单。可以从主流程开始，再检查边界状态。\",\n\t\t\t\t\t\t\"Here is an interface review checklist. Start with the primary flow, then check the edge states.\"\n\t\t\t\t\t),\n\t\t],\n\t\tchecklist: [\n\t\t\ttext(\"确认页面标题与当前场景一致。\", \"Confirm that the page title matches the current view.\"),\n\t\t\ttext(\"让主操作在第一眼就容易找到。\", \"Make the primary action easy to find.\"),\n\t\t\ttext(\n\t\t\t\t\"检查普通、悬停、按下和禁用状态。\",\n\t\t\t\t\"Check default, hover, pressed, and disabled states.\"\n\t\t\t),\n\t\t\ttext(\"用键盘完成一次完整流程。\", \"Complete the flow using only a keyboard.\"),\n\t\t\ttext(\"确认切换视图后焦点有明确去向。\", \"Verify where focus goes after changing views.\"),\n\t\t\ttext(\"检查长标题和文件名的截断方式。\", \"Check how long titles and filenames truncate.\"),\n\t\t\ttext(\"验证空状态能引导下一步操作。\", \"Verify that the empty state offers a next step.\"),\n\t\t\ttext(\"确保加载中的状态可辨认。\", \"Make loading states easy to recognize.\"),\n\t\t\ttext(\"检查失败后能否继续编辑或重试。\", \"Check that users can edit or retry after an error.\"),\n\t\t\ttext(\"对照浅色和深色下的文字对比度。\", \"Compare text contrast in both color schemes.\"),\n\t\t\ttext(\"在窄屏上检查换行和按钮触达。\", \"Check wrapping and control access on narrow screens.\"),\n\t\t\ttext(\n\t\t\t\t\"验证长列表的阅读位置和回到最新。\",\n\t\t\t\t\"Verify reading position and jumping to the latest item.\"\n\t\t\t),\n\t\t\ttext(\"确认减少动态效果时控件仍易于理解。\", \"Verify controls with reduced motion enabled.\"),\n\t\t\ttext(\"检查图标按钮都有清晰的可访问名称。\", \"Check accessible names for icon-only buttons.\"),\n\t\t\ttext(\n\t\t\t\t\"核对状态更新能否被辅助技术感知。\",\n\t\t\t\t\"Check that assistive technology receives status updates.\"\n\t\t\t),\n\t\t\ttext(\n\t\t\t\t\"记录仍需复测的交互和环境。\",\n\t\t\t\t\"Record any interactions or environments that need another pass.\"\n\t\t\t),\n\t\t],\n\t};\n}\n\nexport function sampleChats(text: Copy): Chat[] {\n\tconst reply = replyFor(text);\n\treturn [\n\t\t{\n\t\t\tid: \"sample\",\n\t\t\ttitle: text(\"界面评审清单\", \"Interface review checklist\"),\n\t\t\tlabel: text(\"示例\", \"Sample\"),\n\t\t\tturns: [\n\t\t\t\t{\n\t\t\t\t\tid: \"sample-turn\",\n\t\t\t\t\tprompt: text(\"给我一份界面评审清单。\", \"Give me an interface review checklist.\"),\n\t\t\t\t\tfiles: [],\n\t\t\t\t\tphase: \"done\",\n\t\t\t\t\ttool: \"search\",\n\t\t\t\t\ttoolDone: true,\n\t\t\t\t\tworkedSeconds: 3,\n\t\t\t\t\treply: reply.paragraphs,\n\t\t\t\t\tchecklist: reply.checklist,\n\t\t\t\t},\n\t\t\t],\n\t\t},\n\t];\n}\n",
			"type": "registry:page",
			"target": "agent-01/data.ts"
		}
	]
}