{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "button-group",
	"title": "Button Group 按钮组",
	"type": "registry:ui",
	"description": "把相关的操作按钮组合在一起，样式连贯。",
	"devDependencies": [
		"tailwind-variants@^3.3.0"
	],
	"registryDependencies": [
		"separator"
	],
	"meta": {
		"valar": {
			"keywords": [
				"按钮组",
				"button group",
				"分段按钮",
				"split button",
				"工具栏"
			],
			"whenToUse": [
				"把相关操作的按钮组合在一起，如按钮加下拉菜单"
			],
			"whenNotToUse": [
				{
					"case": "切换状态而不是执行操作",
					"use": "toggle-group"
				},
				{
					"case": "输入框旁边的按钮",
					"use": "input-group"
				}
			],
			"accessibility": [
				"根元素 role=group，用 aria-label 或 aria-labelledby 命名",
				"用 Tab 在按钮间移动"
			],
			"responsive": [
				"窄屏可改 orientation=vertical",
				"嵌套 ButtonGroup 形成带间距的分组"
			],
			"related": [
				"button",
				"toggle-group",
				"input-group"
			]
		}
	},
	"files": [
		{
			"content": "# Button Group 设计规范\n\n- 用于一组紧密相关、连在一起的按钮（如分段操作、按钮加下拉菜单）；只是并排的独立按钮用普通 flex 间距排列即可。\n- `ButtonGroup.Root` 渲染 `role=\"group\"`，要用 `aria-label` 说明这组按钮做什么。\n- 组内按钮使用相同的 `size`；方向用 `orientation`，组之间需要间距时嵌套多个 ButtonGroup，不要给按钮单独改圆角或边框（组件已处理相邻按钮的圆角和边框）。\n- 组内的说明文字用 `ButtonGroup.Text`，分隔用 `ButtonGroup.Separator`；Input、Select 等控件也可以放进组内。\n- 横向胶囊拆分按钮使用 `variant=\"pill\"`，配两个 `size=\"icon-sm\"` 的图标按钮和 `ButtonGroup.Separator`。样式参考 Linear Issue 顶栏的提示词操作组。两个动作各自命名，键盘焦点在按钮边界内显示。\n",
			"type": "registry:file",
			"target": "button-group/RULES.md"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Separator } from \"$UI$/separator/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\timport type { ComponentProps } from \"svelte\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\torientation = \"vertical\",\n\t\t...restProps\n\t}: ComponentProps<typeof Separator> = $props();\n</script>\n\n<Separator\n\tbind:ref\n\tdata-slot=\"button-group-separator\"\n\t{orientation}\n\tclass={cn(\n\t\t\"bg-input relative self-stretch data-horizontal:mx-px data-horizontal:w-auto data-vertical:my-px data-vertical:h-auto\",\n\t\tclassName\n\t)}\n\t{...restProps}\n/>\n",
			"type": "registry:file",
			"target": "button-group/button-group-separator.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { Snippet } from \"svelte\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchild,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\tchild?: Snippet<[{ props: Record<string, unknown> }]>;\n\t} = $props();\n\n\tconst mergedProps = $derived({\n\t\t...restProps,\n\t\tclass: cn(\"bg-muted gap-2 rounded-lg border px-2.5 text-sm font-medium [&_svg:not([class*='size-'])]:size-4 flex items-center [&_svg]:pointer-events-none\", className),\n\t\t\"data-slot\": \"button-group-text\",\n\t});\n</script>\n\n{#if child}\n\t{@render child({ props: mergedProps })}\n{:else}\n\t<div bind:this={ref} {...mergedProps}>\n\t\t{@render mergedProps.children?.()}\n\t</div>\n{/if}\n",
			"type": "registry:file",
			"target": "button-group/button-group-text.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n\timport { tv, type VariantProps } from \"tailwind-variants\";\n\n\texport const buttonGroupVariants = tv({\n\t\tbase: \"has-[>[data-slot=button-group]]:gap-2 has-[select[aria-hidden=true]:last-child]:[&>[data-slot=select-trigger]:last-of-type]:rounded-r-lg group/button-group flex w-fit items-stretch *:focus-visible:relative *:focus-visible:z-10 [&>[data-slot=select-trigger]:not([class*='w-'])]:w-fit [&>input]:flex-1\",\n\t\tvariants: {\n\t\t\tvariant: {\n\t\t\t\tdefault: \"\",\n\t\t\t\tpill: \"\",\n\t\t\t},\n\t\t\torientation: {\n\t\t\t\thorizontal:\n\t\t\t\t\t\"[&>[data-slot]:not(:has(~[data-slot]))]:rounded-r-lg! [&>*:not(:first-child)]:rounded-l-none [&>*:not(:first-child)]:border-l-0 [&>*:not(:last-child)]:rounded-r-none\",\n\t\t\t\tvertical:\n\t\t\t\t\t\"[&>[data-slot]:not(:has(~[data-slot]))]:rounded-b-lg! flex-col [&>*:not(:first-child)]:rounded-t-none [&>*:not(:first-child)]:border-t-0 [&>*:not(:last-child)]:rounded-b-none\",\n\t\t\t},\n\t\t},\n\t\tcompoundVariants: [\n\t\t\t{ variant: \"pill\", orientation: \"horizontal\", class: \"items-center rounded-full bg-[lch(99.997%_0.5_282)] text-[color:lch(39.176%_1.25_282)] shadow-[0_0_0_0.5px_rgb(0_0_0_/_9%),0_3px_6px_-2px_rgb(0_0_0_/_2%),0_1px_1px_rgb(0_0_0_/_4%)] dark:bg-[lch(10.149%_0.689_272)] dark:text-[color:lch(61.803%_1.2_272)] dark:shadow-[0_0_0_0.5px_rgb(255_255_255_/_13.7%),0_0.5px_1px_1px_rgb(0_0_0_/_30%)] [&>:is(button,a)]:border-0 [&>:is(button,a)]:text-inherit [&>:is(button,a)]:shadow-none [&>:is(button,a)]:active:translate-y-0 [&[data-variant=pill]>:is(button,a):first-child]:rounded-l-full! [&[data-variant=pill]>:is(button,a):last-child]:rounded-r-full! [&>:is(button,a):is(:hover,[aria-expanded=true])]:bg-[lch(95.883%_0.157_282)] [&>:is(button,a):is(:hover,[aria-expanded=true])]:text-[color:lch(19.588%_1.25_282)] dark:[&>:is(button,a):is(:hover,[aria-expanded=true])]:bg-[lch(14.777%_1.075_272)] dark:[&>:is(button,a):is(:hover,[aria-expanded=true])]:text-[color:lch(90.451%_1.2_272)] [&>:is(button,a):focus-visible]:ring-0 [&>:is(button,a):focus-visible]:outline-1 [&>:is(button,a):focus-visible]:-outline-offset-1 [&>:is(button,a):focus-visible]:outline-solid [&>:is(button,a):focus-visible]:outline-[color:lch(53%_52.26_286.91)] dark:[&>:is(button,a):focus-visible]:outline-[color:lch(47.918%_59.303_288.421)] [&>[data-slot=button-group-separator]]:m-0 [&>[data-slot=button-group-separator]]:h-5 [&>[data-slot=button-group-separator]]:w-[0.5px] [&>[data-slot=button-group-separator]]:self-center [&>[data-slot=button-group-separator]]:bg-black/[4.5%] dark:[&>[data-slot=button-group-separator]]:bg-white/[6.85%]\" },\n\t\t],\n\t\tdefaultVariants: {\n\t\t\tvariant: \"default\",\n\t\t\torientation: \"horizontal\",\n\t\t},\n\t});\n\n\texport type ButtonGroupVariant = VariantProps<typeof buttonGroupVariants>[\"variant\"];\n\texport type ButtonGroupOrientation = VariantProps<typeof buttonGroupVariants>[\"orientation\"];\n</script>\n\n<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\torientation = \"horizontal\",\n\t\tvariant = \"default\",\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\torientation?: ButtonGroupOrientation;\n\t\tvariant?: ButtonGroupVariant;\n\t} = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\trole=\"group\"\n\tdata-slot=\"button-group\"\n\tdata-orientation={orientation}\n\tdata-variant={variant}\n\tclass={cn(buttonGroupVariants({ orientation, variant }), className)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "button-group/button-group.svelte"
		},
		{
			"content": "import Separator from \"./button-group-separator.svelte\";\nimport Text from \"./button-group-text.svelte\";\nimport Root, {\n\tbuttonGroupVariants,\n\ttype ButtonGroupOrientation,\n\ttype ButtonGroupVariant,\n} from \"./button-group.svelte\";\n\nexport {\n\tRoot,\n\tText,\n\tSeparator,\n\tbuttonGroupVariants,\n\ttype ButtonGroupOrientation,\n\ttype ButtonGroupVariant,\n\t//\n\tRoot as ButtonGroup,\n\tText as ButtonGroupText,\n\tSeparator as ButtonGroupSeparator,\n};\n",
			"type": "registry:file",
			"target": "button-group/index.ts"
		}
	]
}