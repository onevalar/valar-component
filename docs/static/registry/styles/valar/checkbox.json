	"files": [
		{
			"content": "# Checkbox 设计规范\n\n- Valar 默认复选框参考 Linear 的 Issue labels 列表。方框为 14 × 14 px、圆角 3 px、描边 1 px，未选中底色透明，选中时使用主题蓝紫色及 10 px 浅色勾选图标。\n- 单项复选框使用边界内的焦点提示。方框与勾选标记即时切换。Valar 采用同一强调底色和短横线表达部分选中，禁用与错误沿用表单规则。\n- 每个 Checkbox 都要有可点击的标签：给 Checkbox 设 `id`，用 `Field.Label for={id}`（或 Label）关联，并放在 `<Field.Field orientation=\"horizontal\">` 中（检查规则 `valar/input-label`）。\n- 一组相关的复选框用 `Field.Set` + `Field.Legend` 说明这一组是什么。\n- 用于需要点“保存”“提交”才生效的选项；立即生效的设置用 Switch，多选一用 Radio Group。\n- 状态用 `bind:checked`；部分选中（如“全选”下只选了一部分）用 `indeterminate`，不要换图标模拟。\n- 放在原生表单中提交时设 `name` 和 `value`。错误状态用 `aria-invalid=\"true\"` 加 `Field.Error`（检查规则 `valar/invalid-via-aria`）。\n",
			"type": "registry:file",
			"target": "checkbox/RULES.md"
		},
		{
			"content": "<script module lang=\"ts\">\n\texport const checkboxGroupKey = Symbol(\"Valar.CheckboxGroup\");\n</script>\n\n<script lang=\"ts\">\n\timport { checkboxGroup, type CheckboxGroupOptions } from \"@ui-sdk/core/checkbox\";\n\timport { usePart, usePrimitive } from \"@ui-sdk/svelte/primitive\";\n\timport { setContext } from \"svelte\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tid,\n\t\tvalue = $bindable(),\n\t\tdefaultValue,\n\t\tallValues,\n\t\tname,\n\t\tform,\n\t\tdisabled,\n\t\treadonly,\n\t\trequired,\n\t\tonValueChange,\n\t\tchildren,\n\t\t...attrs\n\t}: Omit<HTMLAttributes<HTMLDivElement>, \"defaultValue\"> &\n\t\tPick<\n\t\t\tCheckboxGroupOptions,\n\t\t\t| \"value\"\n\t\t\t| \"defaultValue\"\n\t\t\t| \"allValues\"\n\t\t\t| \"name\"\n\t\t\t| \"form\"\n\t\t\t| \"disabled\"\n\t\t\t| \"required\"\n\t\t\t| \"onValueChange\"\n\t\t> & {\n\t\t\treadonly?: boolean;\n\t\t} = $props();\n\n\tconst uid = $props.id();\n\tconst group = usePrimitive<typeof checkboxGroup>(checkboxGroup, () => ({\n\t\tid: id ?? uid,\n\t\tvalue,\n\t\tdefaultValue,\n\t\tallValues,\n\t\tname,\n\t\tform,\n\t\tdisabled,\n\t\treadOnly: readonly,\n\t\trequired,\n\t\tonValueChange(next, details) {\n\t\t\tonValueChange?.(next, details);\n\t\t\tif (!details.canceled) value = next;\n\t\t}\n\t}));\n\tsetContext(checkboxGroupKey, () => group.api);\n\tconst root = usePart<typeof checkboxGroup, \"group\">(group, \"group\");\n\tconst input = usePart<typeof checkboxGroup, \"group-input\">(group, \"group-input\");\n</script>\n\n<div {...root.slot(attrs)} data-slot=\"checkbox-group\">\n\t{@render children?.()}\n</div>\n<input {...input.slot()} />\n",
			"type": "registry:file",
			"target": "checkbox/checkbox-group.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { checkbox, type CheckboxGroupApi } from \"@ui-sdk/core/checkbox\";\n\timport { usePart, usePrimitive } from \"@ui-sdk/svelte/primitive\";\n\timport { getContext } from \"svelte\";\n\timport { styleToString } from \"svelte-toolbelt\";\n\timport type { HTMLButtonAttributes } from \"svelte/elements\";\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { cn } from \"$UTILS$.js\";\n\timport { checkboxGroupKey } from \"./checkbox-group.svelte\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tchecked = $bindable(false),\n\t\tindeterminate = $bindable(false),\n\t\tclass: className,\n\t\tid: userId,\n\t\tdisabled = false,\n\t\treadonly = false,\n\t\trequired = false,\n\t\tname,\n\t\tvalue = \"on\",\n\t\tform,\n\t\ttype = \"button\",\n\t\ttabindex,\n\t\tstyle,\n\t\tparent,\n\t\tonCheckedChange,\n\t\tonIndeterminateChange,\n\t\tonkeydown,\n\t\tonclick,\n\t\t...restProps\n\t}: Omit<HTMLButtonAttributes, \"children\" | \"value\" | \"style\"> & {\n\t\tref?: HTMLButtonElement | null;\n\t\tchecked?: boolean;\n\t\tindeterminate?: boolean;\n\t\treadonly?: boolean | null;\n\t\trequired?: boolean;\n\t\tvalue?: string;\n\t\tstyle?: string | Record<string, string | number | null | undefined> | null;\n\t\tparent?: boolean;\n\t\tonCheckedChange?: (checked: boolean) => void;\n\t\tonIndeterminateChange?: (indeterminate: boolean) => void;\n\t} = $props();\n\n\tconst uid = $props.id();\n\tconst group = getContext<(() => CheckboxGroupApi) | undefined>(checkboxGroupKey);\n\tconst handle = usePrimitive<typeof checkbox>(checkbox, () => ({\n\t\tid: userId ?? uid,\n\t\tchecked: indeterminate ? \"indeterminate\" : checked,\n\t\tgroup,\n\t\tparent,\n\t\tvalue,\n\t\tname: group ? (name ?? undefined) : undefined,\n\t\tform: group ? (form ?? undefined) : undefined,\n\t\tdisabled: Boolean(disabled),\n\t\treadOnly: Boolean(readonly),\n\t\trequired,\n\t\tonCheckedChange(next) {\n\t\t\tif (indeterminate) {\n\t\t\t\tindeterminate = false;\n\t\t\t\tonIndeterminateChange?.(false);\n\t\t\t}\n\t\t\tchecked = next === true;\n\t\t\tonCheckedChange?.(checked);\n\t\t}\n\t}));\n\tconst root = usePart<typeof checkbox, \"root\">(handle, \"root\");\n\tconst indicator = usePart<typeof checkbox, \"indicator\">(handle, \"indicator\", () => ({\n\t\tkeepMounted: true\n\t}));\n\tconst input = usePart<typeof checkbox, \"input\">(handle, \"input\");\n\tconst inlineStyle = $derived(style && typeof style === \"object\" ? styleToString(style) : style);\n\tconst state = $derived(root.state.indeterminate ? \"indeterminate\" : root.state.checked);\n\n\tconst nativeClick: NonNullable<HTMLButtonAttributes[\"onclick\"]> = (event) => {\n\t\tonclick?.(event);\n\t\tif (!event.defaultPrevented) handle.api.toggle({ reason: \"press\", event });\n\t};\n\tconst keydown: NonNullable<HTMLButtonAttributes[\"onkeydown\"]> = (event) => {\n\t\tonkeydown?.(event);\n\t\tif (event.defaultPrevented || root.attrs.disabled || readonly) return;\n\t\tif (event.key === \"Enter\") {\n\t\t\tevent.preventDefault();\n\t\t\tif (type === \"submit\") event.currentTarget.form?.requestSubmit();\n\t\t} else if (event.key === \" \") {\n\t\t\tevent.preventDefault();\n\t\t\thandle.api.toggle({ reason: \"press\", event });\n\t\t}\n\t};\n\t// Preserve the native default action of an explicitly configured submit button.\n\tconst button = $derived(\n\t\t!group && (type === \"submit\" || readonly)\n\t\t\t? {\n\t\t\t\t\t...restProps,\n\t\t\t\t\t...root.attrs,\n\t\t\t\t\tonclick: nativeClick,\n\t\t\t\t\tonkeydown: keydown\n\t\t\t\t}\n\t\t\t: root.slot({\n\t\t\t\t\t...restProps,\n\t\t\t\t\tid: userId ?? uid,\n\t\t\t\t\tonclick,\n\t\t\t\t\tonkeydown: keydown\n\t\t\t\t})\n\t);\n</script>\n\n<button\n\t{...button}\n\tbind:this={ref}\n\tid={userId ?? uid}\n\t{form}\n\t{type}\n\t{tabindex}\n\tstyle={inlineStyle}\n\trole=\"checkbox\"\n\tdata-slot=\"checkbox\"\n\tdata-checkbox-root=\"\"\n\tdata-state={state === \"indeterminate\" ? state : state ? \"checked\" : \"unchecked\"}\n\tclass={cn(\n\t\t\"flex size-3.5 items-center justify-center rounded-[3px] border bg-transparent transition-none [--valar-checkbox-border-base:lch(52.04%_0_282)] [--valar-checkbox-fill-base:var(--valar-accent-fill,lch(46%_70_267))] [--valar-checkbox-mark-base:var(--valar-accent-ink,lch(100%_3_267))] dark:[--valar-checkbox-border-base:lch(48.72%_1.48_272)] dark:[--valar-checkbox-fill-base:var(--valar-accent-fill,lch(48%_72_267))] dark:[--valar-checkbox-mark-base:var(--valar-accent-ink,lch(100%_3_267))] border-[color:var(--valar-checkbox-border,var(--valar-checkbox-border-base))] data-checked:border-[color:var(--valar-checkbox-fill,var(--valar-checkbox-fill-base))] data-checked:bg-[color:var(--valar-checkbox-fill,var(--valar-checkbox-fill-base))] data-checked:text-[color:var(--valar-checkbox-mark,var(--valar-checkbox-mark-base))] data-[state=indeterminate]:border-[color:var(--valar-checkbox-fill,var(--valar-checkbox-fill-base))] data-[state=indeterminate]:bg-[color:var(--valar-checkbox-fill,var(--valar-checkbox-fill-base))] data-[state=indeterminate]:text-[color:var(--valar-checkbox-mark,var(--valar-checkbox-mark-base))] focus-visible:border-ring focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-1 aria-invalid:ring-inset aria-invalid:ring-destructive/20 aria-invalid:aria-checked:border-[color:var(--valar-checkbox-fill,var(--valar-checkbox-fill-base))] dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 group-has-[:focus-visible]/field-label:ring-0 group-has-[:focus-visible]/field-label:not-data-checked:border-[color:var(--valar-checkbox-border,var(--valar-checkbox-border-base))] group-has-[:focus-visible]/field-label:data-checked:border-[color:var(--valar-checkbox-fill,var(--valar-checkbox-fill-base))] focus-visible:outline-solid focus-visible:outline-1 focus-visible:-outline-offset-2 focus-visible:outline-[color:var(--valar-focus-ring,var(--valar-checkbox-fill,var(--valar-checkbox-fill-base)))] data-checked:focus-visible:outline-[color:var(--valar-checkbox-mark,var(--valar-checkbox-mark-base))] data-[state=indeterminate]:focus-visible:outline-[color:var(--valar-checkbox-mark,var(--valar-checkbox-mark-base))] aria-invalid:focus-visible:outline-destructive peer relative shrink-0 outline-none after:absolute after:-inset-x-3 after:-inset-y-2 disabled:cursor-not-allowed disabled:opacity-50\",\n\t\tclassName\n\t)}\n>\n\t<div\n\t\t{...indicator.slot()}\n\t\tdata-slot=\"checkbox-indicator\"\n\t\tclass=\"[&>svg]:size-2.5 [&>svg]:scale-y-90 grid place-content-center text-current transition-none\"\n\t\taria-hidden=\"true\"\n\t>\n\t\t{#if state === \"indeterminate\"}\n\t\t\t<IconPlaceholder\n\t\t\t\tlucide=\"MinusIcon\"\n\t\t\t\ttabler=\"IconMinus\"\n\t\t\t\thugeicons=\"MinusSignIcon\"\n\t\t\t\tphosphor=\"MinusIcon\"\n\t\t\t\tremixicon=\"RiSubtractLine\"\n\t\t\t/>\n\t\t{:else if state}\n\t\t\t<IconPlaceholder\n\t\t\t\tlucide=\"CheckIcon\"\n\t\t\t\ttabler=\"IconCheck\"\n\t\t\t\thugeicons=\"Tick02Icon\"\n\t\t\t\tphosphor=\"CheckIcon\"\n\t\t\t\tremixicon=\"RiCheckLine\"\n\t\t\t/>\n\t\t{/if}\n\t</div>\n</button>\n\n{#if group}\n\t<input {...input.slot()} />\n{:else if name}\n\t<!-- Standalone fields keep Bits-era FormData and reset behavior without a legacy primitive. -->\n\t<input\n\t\ttype=\"checkbox\"\n\t\t{name}\n\t\t{form}\n\t\t{value}\n\t\t{checked}\n\t\tdefaultChecked={checked}\n\t\t{disabled}\n\t\t{required}\n\t\taria-hidden=\"true\"\n\t\ttabindex={-1}\n\t\tclass=\"sr-only\"\n\t\tonfocus={() => ref?.focus()}\n\t/>\n{/if}\n",
			"type": "registry:file",
			"target": "checkbox/checkbox.svelte"
		},
		{
			"content": "import Root from \"./checkbox.svelte\";\nimport Group from \"./checkbox-group.svelte\";\n\nexport {\n\tRoot,\n\tRoot as Checkbox,\n\tGroup,\n\tGroup as CheckboxGroup,\n};\n",
			"type": "registry:file",
			"target": "checkbox/index.ts"
		}
	]
