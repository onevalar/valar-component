{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "checkbox",
	"title": "Checkbox 复选框",
	"type": "registry:ui",
	"description": "勾选或取消勾选一项，可多选。",
	"dependencies": [
		"@ui-sdk/core@0.1.0-beta.17",
		"@ui-sdk/svelte@0.1.0-beta.17",
		"svelte-toolbelt@0.10.6"
	],
	"meta": {
		"valar": {
			"keywords": [
				"复选框",
				"checkbox",
				"勾选",
				"多选",
				"同意条款"
			],
			"whenToUse": [
				"从多个选项中选任意个",
				"表单提交前确认一项（如同意条款）"
			],
			"whenNotToUse": [
				{
					"case": "立即生效的开关设置",
					"use": "switch"
				},
				{
					"case": "只能选一个",
					"use": "radio-group"
				}
			],
			"accessibility": [
				"每个复选框都有可点击的标签",
				"一组复选框用 FieldSet 和 legend 说明"
