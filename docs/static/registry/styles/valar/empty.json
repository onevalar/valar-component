			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tappearance = \"default\",\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\tappearance?: \"default\" | \"issue-list\" | \"filtered-list\";\n\t} = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"empty\"\n\tdata-appearance={appearance}\n\tclass={cn(\n\t\t\"gap-4 rounded-xl border-dashed p-6 flex w-full min-w-0 flex-1 flex-col items-center justify-center text-center text-balance\",\n\t\tappearance !== \"default\" && \"gap-5 rounded-none border-0 bg-transparent p-0 **:data-[slot=empty-title]:text-[13px] **:data-[slot=empty-title]:font-medium **:data-[slot=empty-title]:tracking-normal **:data-[slot=empty-title]:text-[color:var(--valar-empty-issue-title)] [--valar-empty-issue-title:lch(39.176%_1.25_282)] [--valar-empty-issue-accent:lch(53%_52.26_286.91)] [--valar-empty-issue-accent-foreground:lch(100%_5_286.91)] dark:[--valar-empty-issue-title:lch(61.803%_1.2_272)] dark:[--valar-empty-issue-accent:lch(47.918%_59.303_288.421)] dark:[--valar-empty-issue-accent-foreground:lch(100%_5_288.421)]\",\n\t\tappearance === \"filtered-list\" && \"**:data-[slot=empty-title]:text-[15px]/[23px]! **:data-[slot=empty-title]:font-semibold! [&_[data-slot=empty-content]>[data-slot=button]]:h-6 [&_[data-slot=empty-content]>[data-slot=button]]:rounded-full [&_[data-slot=empty-content]>[data-slot=button]]:px-2 [&_[data-slot=empty-content]>[data-slot=button]]:text-xs\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
