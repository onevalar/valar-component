{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "label",
	"title": "Label 标签",
	"type": "registry:ui",
	"description": "与控件关联的无障碍文字标签。",
	"dependencies": [
		"@ui-sdk/core@0.1.0-beta.17",
		"@ui-sdk/svelte@0.1.0-beta.17",
		"svelte-toolbelt@0.10.6"
	],
	"meta": {
		"valar": {
			"keywords": [
				"标签",
				"label",
				"表单标签",
				"字段名"
			],
			"whenToUse": [
				"为单个控件提供可见、可点击的标签"
			],
			"whenNotToUse": [
				{
					"case": "完整的表单字段（标签、说明、错误）",
					"use": "field"
				}
			],
			"accessibility": [
				"用 for 关联控件的 id",
				"不要用 placeholder 代替标签"
			],
			"responsive": [
				"窄屏下放在控件上方"
			],
			"related": [
				"field",
				"input",
				"checkbox"
			]
		}
	},
	"files": [
		{
			"content": "# Label 设计规范\n\n- 默认标签采用 Linear 设置表单取样的 13 px／500、常规行高。浅色文字 `lch(10% 0 282)`，深色文字 `lch(100% 0 272)`。独立设置行可用 `appearance=\"settings\"`。\n- 表单里优先用 `Field.Label`，它已包含 Label；只在 Field 之外的简单场景直接用 Label。\n- 必须用 `for` 指向控件的 `id`，或把控件包在 Label 里，点击标签才能聚焦或切换控件。\n- 标签写控件的用途。为控件设置原生 `required` 或适用的 `aria-required`。可同时给 Label 传 `required` 显示星号。受限设置项的标题用 Field.Title。独立禁用控件可在标签上设 `data-disabled=\"true\"`，并在控件本身设 `disabled`。\n",
			"type": "registry:file",
			"target": "label/RULES.md"
		},
		{
			"content": "import Root from \"./label.svelte\";\n\nexport {\n\tRoot,\n\t//\n\tRoot as Label,\n};\n",
			"type": "registry:file",
			"target": "label/index.ts"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Label as SdkLabel } from \"@ui-sdk/svelte/label\";\n\timport { styleToString } from \"svelte-toolbelt\";\n\timport { createAttachmentKey } from \"svelte/attachments\";\n\timport { cn } from \"$UTILS$.js\";\n\timport type { Snippet } from \"svelte\";\n\timport type { HTMLLabelAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tappearance = \"default\",\n\t\trequired = false,\n\t\t\"data-slot\": dataSlot = \"label\",\n\t\tchildren,\n\t\tchild,\n\t\tstyle,\n\t\t...restProps\n\t}: Omit<HTMLLabelAttributes, \"style\"> & {\n\t\tref?: HTMLElement | null;\n\t\tchild?: Snippet<[{ props: Record<string, unknown> }]>;\n\t\tstyle?: HTMLLabelAttributes[\"style\"] | Parameters<typeof styleToString>[0];\n\t\tappearance?: \"default\" | \"settings\";\n\t\trequired?: boolean;\n\t\t\"data-slot\"?: string;\n\t} = $props();\n\n\tconst refKey = createAttachmentKey();\n\tconst attachRef = (element: HTMLElement) => {\n\t\tref = element;\n\t\treturn () => {\n\t\t\tif (ref === element) ref = null;\n\t\t};\n\t};\n</script>\n\n<SdkLabel\n\tdata-appearance={appearance}\n\tclass={cn(\n\t\t\"gap-2 text-[13px]/[normal] font-medium text-[color:lch(10%_0_282)] dark:text-[color:lch(100%_0_272)] data-[disabled=true]:opacity-50 group-data-[disabled=true]:opacity-50 peer-disabled:opacity-50 has-[:disabled]:opacity-50 flex items-center select-none group-data-[disabled=true]:pointer-events-none peer-disabled:cursor-not-allowed\",\n\t\t\"\",\n\t\tappearance === \"settings\" && \"cursor-default\",\n\t\tclassName\n\t)}\n\tstyle={style && typeof style === \"object\" ? styleToString(style) : style}\n\t{...restProps}\n>\n\t{#snippet render({ props })}\n\t\t{#if child}\n\t\t\t{@render child({ props: { ...props, \"data-slot\": dataSlot, [refKey]: attachRef } })}\n\t\t{:else}\n\t\t\t<label {...props} data-slot={dataSlot} {@attach attachRef}>\n\t\t\t\t{@render children?.()}\n\t\t\t\t{#if required}\n\t\t\t\t\t<span data-slot=\"label-required\" aria-hidden=\"true\" class=\"text-destructive\">*</span>\n\t\t\t\t{/if}\n\t\t\t</label>\n\t\t{/if}\n\t{/snippet}\n</SdkLabel>\n",
			"type": "registry:file",
			"target": "label/label.svelte"
		}
	]
}