{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "switch",
	"title": "Switch 开关",
	"type": "registry:ui",
	"description": "立即开启或关闭一个设置。",
	"dependencies": [
		"@ui-sdk/core@0.1.0-beta.17",
		"@ui-sdk/svelte@0.1.0-beta.17",
		"svelte-toolbelt@0.10.6"
	],
	"meta": {
		"valar": {
			"keywords": [
				"开关",
				"switch",
				"toggle",
				"启用",
				"设置"
			],
			"whenToUse": [
				"改动立即生效的二元设置"
			],
			"whenNotToUse": [
				{
					"case": "需要点提交才生效的选项",
					"use": "checkbox"
				},
				{
					"case": "多个互斥选项",
					"use": "radio-group"
				}
			],
			"accessibility": [
				"开关有可见标签说明它控制什么",
				"状态由 aria-checked 表达，不只靠颜色"
			],
			"responsive": [
				"设置列表中标签在左、开关在右"
			],
			"related": [
				"checkbox",
				"toggle"
			]
		}
	},
	"files": [
		{
			"content": "# Switch 设计规范\n\n- 用于立即生效的开关设置；需要点“保存”才生效的选项用 Checkbox。\n- 每个 Switch 都要有可见标签说明它控制什么：设 `id`，用 `Field.Label for={id}` 关联，放在 `<Field.Field orientation=\"horizontal\">` 中，标签在前、开关在后（检查规则 `valar/input-label`）。\n- 标签写被控制的功能（“邮件通知”），不要写“开启／关闭”；状态由组件的 `aria-checked` 表达，不要在旁边再加“已开启”文字代替标签。\n- 状态用 `bind:checked`；切换会触发耗时请求时，请求期间设 `disabled`，失败时恢复原值并提示。\n- 尺寸只用 `size` 属性（`sm`、`default`），不要用 `class` 改宽高。\n- `default` 用于设置行，轨道 30 × 20 px、滑块 14 × 14 px。`sm` 用于紧凑工具栏或弹窗底部，轨道 22 × 14 px、滑块 10 × 10 px。弹窗底部将短标签与 Switch 同行，再与主操作分组。\n- 轨道背景与透明度使用 150 ms `ease-out`。减少动态效果时立即切换。实测参考与后续滑块动效对齐见 `standards/DESIGN.md`。\n- 关闭时使用灰色轨道，开启时使用强调色。滑块两侧各过渡 100 ms，其中一侧延迟 50 ms，切换方向时交换延迟。设置区可通过 `--settings-switch-off`、`--settings-switch-on` 与 `--settings-focus` 提供主题色。\n- 键盘焦点描边向内收 1 px。关闭时用强调色，开启时用白色与轨道区分，错误状态用错误色。禁用、等待和错误示例采用 Valar 的表单反馈规则。\n",
			"type": "registry:file",
			"target": "switch/RULES.md"
		},
		{
			"content": "import Root from \"./switch.svelte\";\n\nexport {\n\tRoot,\n\t//\n\tRoot as Switch,\n};\n",
			"type": "registry:file",
			"target": "switch/index.ts"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { switchPrimitive } from \"@ui-sdk/core/switch\";\n\timport { usePart, usePrimitive } from \"@ui-sdk/svelte/primitive\";\n\timport { styleToString } from \"svelte-toolbelt\";\n\timport type { HTMLButtonAttributes } from \"svelte/elements\";\n\timport { cn } from \"$UTILS$.js\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchecked = $bindable(false),\n\t\tsize = \"default\",\n\t\tappearance = \"default\",\n\t\tid: userId,\n\t\tdisabled = false,\n\t\trequired = false,\n\t\tname,\n\t\tvalue = \"on\",\n\t\ttype = \"button\",\n\t\ttabindex,\n\t\tstyle,\n\t\tonCheckedChange,\n\t\tonkeydown,\n\t\tonclick,\n\t\t...restProps\n\t}: Omit<HTMLButtonAttributes, \"children\" | \"style\"> & {\n\t\tref?: HTMLButtonElement | null;\n\t\tchecked?: boolean;\n\t\trequired?: boolean;\n\t\tstyle?: string | Record<string, string | number | null | undefined> | null;\n\t\tsize?: \"sm\" | \"default\";\n\t\tappearance?: \"default\" | \"settings\";\n\t\tonCheckedChange?: (checked: boolean) => void;\n\t} = $props();\n\n\tconst uid = $props.id();\n\tconst handle = usePrimitive<typeof switchPrimitive>(switchPrimitive, () => ({\n\t\tid: userId ?? uid,\n\t\tchecked,\n\t\tdisabled: Boolean(disabled),\n\t\trequired,\n\t\tonCheckedChange(next) {\n\t\t\tchecked = next;\n\t\t\tonCheckedChange?.(next);\n\t\t}\n\t}));\n\tconst root = usePart<typeof switchPrimitive, \"root\">(handle, \"root\");\n\tconst thumb = usePart<typeof switchPrimitive, \"thumb\">(handle, \"thumb\");\n\tconst inlineStyle = $derived(style && typeof style === \"object\" ? styleToString(style) : style);\n\n\t// Keep the button's native pointer default (including type=\"submit\"),\n\t// while routing both keyboard and pointer switches through the SDK.\n\tconst click: NonNullable<HTMLButtonAttributes[\"onclick\"]> = (event) => {\n\t\tonclick?.(event);\n\t\tif (!event.defaultPrevented) handle.api.toggle({ reason: \"press\", event });\n\t};\n\tconst keydown: NonNullable<HTMLButtonAttributes[\"onkeydown\"]> = (event) => {\n\t\tonkeydown?.(event);\n\t\tif (event.defaultPrevented || disabled || (event.key !== \"Enter\" && event.key !== \" \")) return;\n\t\tevent.preventDefault();\n\t\thandle.api.toggle({ reason: \"press\", event });\n\t};\n</script>\n\n<button\n\t{...restProps}\n\t{...root.attrs}\n\tbind:this={ref}\n\tid={userId ?? uid}\n\t{type}\n\t{tabindex}\n\tstyle={inlineStyle}\n\tonclick={click}\n\tonkeydown={keydown}\n\trole=\"switch\"\n\tdata-slot=\"switch\"\n\tdata-switch-root=\"\"\n\tdata-state={checked ? \"checked\" : \"unchecked\"}\n\tdata-size={size}\n\tdata-appearance={appearance}\n\tclass={cn(\n\t\t\"data-checked:bg-[color:var(--settings-switch-on,var(--settings-focus,var(--valar-accent-fill,lch(46%_70_267))))] data-unchecked:bg-[color:var(--settings-switch-off,lch(82.484%_.054_281.837))] dark:data-checked:bg-[color:var(--settings-switch-on,var(--settings-focus,var(--valar-accent-fill,lch(48%_72_267))))] dark:data-unchecked:bg-[color:var(--settings-switch-off,lch(47.551%_.913_271.998))] focus-visible:outline-1 focus-visible:-outline-offset-1 focus-visible:outline-solid focus-visible:outline-[color:var(--settings-focus,var(--valar-focus-ring,lch(46%_70_267)))] dark:focus-visible:outline-[color:var(--settings-focus,var(--valar-focus-ring,lch(48%_72_267)))] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 shrink-0 rounded-full border border-transparent aria-invalid:ring-1 aria-invalid:ring-inset data-[size=default]:h-5 data-[size=default]:w-[30px] data-[size=default]:px-0.5 data-[size=sm]:h-[14px] data-[size=sm]:w-[22px] data-[size=sm]:px-px focus-visible:data-checked:outline-white dark:focus-visible:data-checked:outline-white focus-visible:aria-invalid:outline-destructive! dark:data-[size=sm]:data-unchecked:bg-[color:var(--settings-switch-off,lch(48.296%_1.13_271.996))] peer group/switch relative inline-flex items-center transition-[background-color,opacity] duration-150 ease-out outline-none after:absolute after:-inset-x-3 after:-inset-y-2 motion-reduce:transition-none data-disabled:cursor-not-allowed data-disabled:opacity-50\",\n\t\tclassName\n\t)}\n>\n\t<span\n\t\t{...thumb.slot()}\n\t\tdata-slot=\"switch-thumb\"\n\t\tdata-switch-thumb=\"\"\n\t\tdata-state={checked ? \"checked\" : \"unchecked\"}\n\t\tclass={cn(\n\t\t\t\"bg-[lch(100%_3_267)] dark:bg-[lch(100%_3_267)] rounded-full group-data-[size=default]/switch:size-3.5 group-data-[size=sm]/switch:size-2.5 pointer-events-none block shrink-0 ring-0 duration-100 ease-out motion-reduce:transition-none\",\n\t\t\t\"absolute top-1/2 w-auto! -translate-y-1/2 translate-x-0! transition-[inset-inline-start,inset-inline-end] delay-[0ms,50ms] data-checked:delay-[50ms,0ms] group-data-[size=default]/switch:start-0.5 group-data-[size=default]/switch:end-[calc(50%_-_2px)] group-data-[size=default]/switch:data-checked:start-[calc(50%_-_2px)] group-data-[size=default]/switch:data-checked:end-0.5 group-data-[size=sm]/switch:start-px group-data-[size=sm]/switch:end-[calc(50%_-_1px)] group-data-[size=sm]/switch:data-checked:start-[calc(50%_-_1px)] group-data-[size=sm]/switch:data-checked:end-px motion-reduce:transition-none\"\n\t\t)}\n\t></span>\n</button>\n\n{#if name !== undefined}\n\t<!-- For a standalone Switch, the form attribute has always belonged to the button. -->\n\t<input\n\t\ttype=\"checkbox\"\n\t\t{name}\n\t\t{value}\n\t\t{checked}\n\t\tdefaultChecked={checked}\n\t\t{disabled}\n\t\t{required}\n\t\taria-hidden=\"true\"\n\t\ttabindex={-1}\n\t\tclass=\"sr-only\"\n\t/>\n{/if}\n",
			"type": "registry:file",
			"target": "switch/switch.svelte"
		}
	]
}