		{
			"content": "<script lang=\"ts\">\n\timport { PaginationLink as SdkLink } from \"@ui-sdk/svelte/pagination\";\n\timport { styleToString } from \"svelte-toolbelt\";\n\timport { createAttachmentKey } from \"svelte/attachments\";\n\timport { buttonVariants, type ButtonSize } from \"$UI$/button/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\timport type { Pagination as PaginationPrimitive } from \"bits-ui\";\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tsize = \"icon\",\n\t\tisActive,\n\t\tpage,\n\t\tchildren,\n\t\tchild,\n\t\tdisabled,\n\t\tstyle,\n\t\t...restProps\n\t}: PaginationPrimitive.PageProps & {\n\t\tsize?: ButtonSize;\n\t\tisActive: boolean;\n\t} = $props();\n\tconst refProps = {\n\t\t[createAttachmentKey()]: (element: HTMLButtonElement) => {\n\t\t\tref = element;\n\t\t\treturn () => {\n\t\t\t\tif (ref === element) ref = null;\n\t\t\t};\n\t\t},\n\t};\n</script>\n\n<SdkLink\n\tpage={page.value}\n\taria-label={`Page ${page.value}`}\n\tdata-slot=\"pagination-link\"\n\tdata-pagination-page=\"\"\n\tdata-pagination-control=\"\"\n\tdata-value={page.value}\n\tdata-active={isActive}\n\tdata-size={size}\n\tclass={cn(\n\t\tbuttonVariants({ size, variant: isActive ? \"outline\" : \"ghost\" }),\n\t\t\"tabular-nums\",\n\t\tclassName\n\t)}\n\tstyle={style && typeof style === \"object\" ? styleToString(style) : style}\n\t{...restProps as Record<string, unknown>}\n>\n\t{#snippet render({ props, state })}\n\t\t{@const button = {\n\t\t\t...props,\n\t\t\t...refProps,\n\t\t\tdisabled,\n\t\t\t\"aria-current\": isActive ? (\"page\" as const) : undefined,\n\t\t\t\"data-selected\": state.current ? \"\" : undefined,\n\t\t}}\n\t\t{#if child}\n\t\t\t{@render child({ props: button })}\n\t\t{:else}\n\t\t\t<button {...button}\n\t\t\t\t>{#if children}{@render children()}{:else}{page.value}{/if}</button\n\t\t\t>\n\t\t{/if}\n\t{/snippet}\n</SdkLink>\n",
			"type": "registry:file",
			"target": "pagination/pagination-link.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { PaginationNext as SdkNext } from \"@ui-sdk/svelte/pagination\";\n\timport { styleToString } from \"svelte-toolbelt\";\n\timport { createAttachmentKey } from \"svelte/attachments\";\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { cn } from \"$UTILS$.js\";\n\timport { buttonVariants } from \"../button/index.js\";\n\timport type { Pagination as PaginationPrimitive } from \"bits-ui\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\tchild,\n\t\tdisabled,\n\t\tlabel = \"下一页\",\n\t\tstyle,\n\t\t...restProps\n\t}: PaginationPrimitive.NextButtonProps & {\n\t\t/** Visible button text. */\n\t\tlabel?: string;\n\t} = $props();\n\tconst refProps = {\n\t\t[createAttachmentKey()]: (element: HTMLButtonElement) => {\n\t\t\tref = element;\n\t\t\treturn () => {\n\t\t\t\tif (ref === element) ref = null;\n\t\t\t};\n\t\t},\n\t};\n</script>\n\n{#snippet Fallback()}\n\t<span>{label}</span>\n\t<IconPlaceholder\n\t\tlucide=\"ChevronRightIcon\"\n\t\ttabler=\"IconChevronRight\"\n\t\thugeicons=\"ArrowRightIcon\"\n\t\tphosphor=\"CaretRightIcon\"\n\t\tremixicon=\"RiArrowRightSLine\"\n\t\tclass={cn(\"cn-rtl-flip size-4\", className)}\n\t/>\n{/snippet}\n\n<SdkNext\n\taria-label=\"下一页\"\n\tdata-pagination-next=\"\"\n\tdata-pagination-control=\"\"\n\tclass={cn(buttonVariants({ variant: \"ghost\" }), \"pr-1.5!\", className)}\n\tstyle={style && typeof style === \"object\" ? styleToString(style) : style}\n\t{...restProps as Record<string, unknown>}\n>\n\t{#snippet render({ props, state })}\n\t\t{@const button = { ...props, ...refProps, disabled: disabled || state.disabled }}\n\t\t{#if child}\n\t\t\t{@render child({ props: button })}\n\t\t{:else}\n\t\t\t<button {...button}\n\t\t\t\t>{#if children}{@render children()}{:else}{@render Fallback()}{/if}</button\n\t\t\t>\n\t\t{/if}\n\t{/snippet}\n</SdkNext>\n",
			"type": "registry:file",
			"target": "pagination/pagination-next-button.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Pagination as PaginationPrimitive } from \"bits-ui\";\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport NextButton from \"./pagination-next-button.svelte\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tlabel = \"下一页\",\n\t\tchildren: _children,\n\t\t...restProps\n\t}: PaginationPrimitive.NextButtonProps & {\n\t\t/** Visible button text. */\n\t\tlabel?: string;\n\t} = $props();\n</script>\n\n<NextButton bind:ref {label} {...restProps}>\n\t<span class=\"hidden sm:block\">{label}</span>\n\t<IconPlaceholder\n\t\tlucide=\"ChevronRightIcon\"\n\t\ttabler=\"IconChevronRight\"\n\t\thugeicons=\"ArrowRight01Icon\"\n\t\tphosphor=\"CaretRightIcon\"\n\t\tremixicon=\"RiArrowRightSLine\"\n\t\tdata-icon=\"inline-end\"\n\t\tclass=\"cn-rtl-flip\"\n\t/>\n</NextButton>\n",
			"type": "registry:file",
			"target": "pagination/pagination-next.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { PaginationPrevious as SdkPrevious } from \"@ui-sdk/svelte/pagination\";\n\timport { styleToString } from \"svelte-toolbelt\";\n\timport { createAttachmentKey } from \"svelte/attachments\";\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { cn } from \"$UTILS$.js\";\n\timport { buttonVariants } from \"../button/index.js\";\n\timport type { Pagination as PaginationPrimitive } from \"bits-ui\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\tchild,\n\t\tdisabled,\n\t\tlabel = \"上一页\",\n\t\tstyle,\n\t\t...restProps\n\t}: PaginationPrimitive.PrevButtonProps & {\n\t\t/** Visible button text. */\n\t\tlabel?: string;\n\t} = $props();\n\tconst refProps = {\n\t\t[createAttachmentKey()]: (element: HTMLButtonElement) => {\n\t\t\tref = element;\n\t\t\treturn () => {\n\t\t\t\tif (ref === element) ref = null;\n\t\t\t};\n\t\t},\n\t};\n</script>\n\n{#snippet Fallback()}\n\t<IconPlaceholder\n\t\tlucide=\"ChevronLeftIcon\"\n\t\ttabler=\"IconChevronLeft\"\n\t\thugeicons=\"ArrowLeftIcon\"\n\t\tphosphor=\"CaretLeftIcon\"\n\t\tremixicon=\"RiArrowLeftSLine\"\n\t\tclass={cn(\"cn-rtl-flip size-4\", className)}\n\t/>\n\t<span>{label}</span>\n{/snippet}\n\n<SdkPrevious\n\taria-label=\"上一页\"\n\tdata-pagination-prev=\"\"\n\tdata-pagination-control=\"\"\n\tclass={cn(buttonVariants({ variant: \"ghost\" }), \"pl-1.5!\", className)}\n\tstyle={style && typeof style === \"object\" ? styleToString(style) : style}\n\t{...restProps as Record<string, unknown>}\n>\n\t{#snippet render({ props, state })}\n\t\t{@const button = { ...props, ...refProps, disabled: disabled || state.disabled }}\n\t\t{#if child}\n\t\t\t{@render child({ props: button })}\n\t\t{:else}\n\t\t\t<button {...button}\n\t\t\t\t>{#if children}{@render children()}{:else}{@render Fallback()}{/if}</button\n\t\t\t>\n\t\t{/if}\n\t{/snippet}\n</SdkPrevious>\n",
			"type": "registry:file",
			"target": "pagination/pagination-prev-button.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Pagination as PaginationPrimitive } from \"bits-ui\";\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport PrevButton from \"./pagination-prev-button.svelte\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tlabel = \"上一页\",\n\t\tchildren: _children,\n\t\t...restProps\n\t}: PaginationPrimitive.PrevButtonProps & {\n\t\t/** Visible button text. */\n\t\tlabel?: string;\n\t} = $props();\n</script>\n\n<PrevButton bind:ref {label} {...restProps}>\n\t<IconPlaceholder\n\t\tlucide=\"ChevronLeftIcon\"\n\t\ttabler=\"IconChevronLeft\"\n\t\thugeicons=\"ArrowLeft01Icon\"\n\t\tphosphor=\"CaretLeftIcon\"\n\t\tremixicon=\"RiArrowLeftSLine\"\n\t\tdata-icon=\"inline-start\"\n\t\tclass=\"cn-rtl-flip\"\n\t/>\n\t<span class=\"hidden sm:block\">{label}</span>\n</PrevButton>\n",
			"type": "registry:file",
			"target": "pagination/pagination-previous.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Pagination as SdkPagination } from \"@ui-sdk/svelte/pagination\";\n\timport { styleToString } from \"svelte-toolbelt\";\n\timport { createAttachmentKey } from \"svelte/attachments\";\n\timport { cn } from \"$UTILS$.js\";\n\timport type { Pagination as PaginationPrimitive } from \"bits-ui\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tcount = 0,\n\t\tperPage = 10,\n\t\tpage = $bindable(1),\n\t\tsiblingCount = 1,\n\t\tloop = false,\n\t\torientation = \"horizontal\",\n\t\tonPageChange,\n\t\tonkeydown,\n\t\tchildren,\n\t\tchild,\n\t\tstyle,\n\t\t...restProps\n\t}: PaginationPrimitive.RootProps = $props();\n\tconst refProps = {\n\t\t[createAttachmentKey()]: (element: HTMLElement) => {\n\t\t\tref = element;\n\t\t\treturn () => {\n\t\t\t\tif (ref === element) ref = null;\n\t\t\t};\n\t\t},\n\t};\n\n\tfunction keydown(event: KeyboardEvent & { currentTarget: EventTarget & HTMLDivElement }) {\n\t\tonkeydown?.(event);\n\t\tif (\n\t\t\tevent.defaultPrevented ||\n\t\t\tevent.altKey ||\n\t\t\tevent.ctrlKey ||\n\t\t\tevent.metaKey ||\n\t\t\t!(event.target instanceof Element)\n\t\t)\n\t\t\treturn;\n\t\tconst root = event.currentTarget;\n\t\tconst target = event.target.closest(\"[data-pagination-control]\");\n\t\tif (target?.closest(\"[data-pagination-root]\") !== root) return;\n\t\tconst rtl = getComputedStyle(root).direction === \"rtl\";\n\t\tconst forward = orientation === \"vertical\" ? \"ArrowDown\" : rtl ? \"ArrowLeft\" : \"ArrowRight\";\n\t\tconst backward = orientation === \"vertical\" ? \"ArrowUp\" : rtl ? \"ArrowRight\" : \"ArrowLeft\";\n\t\tconst controls = Array.from(\n\t\t\troot.querySelectorAll<HTMLButtonElement>(\"[data-pagination-control]:not(:disabled)\")\n\t\t).filter((control) => control.closest(\"[data-pagination-root]\") === root);\n\t\tconst index = controls.indexOf(target as HTMLButtonElement);\n\t\tif (index === -1) return;\n\t\tconst last = controls.length - 1;\n\t\tconst next =\n\t\t\tevent.key === \"Home\"\n\t\t\t\t? 0\n\t\t\t\t: event.key === \"End\"\n\t\t\t\t\t? last\n\t\t\t\t\t: event.key === forward\n\t\t\t\t\t\t? index + 1\n\t\t\t\t\t\t: event.key === backward\n\t\t\t\t\t\t\t? index - 1\n\t\t\t\t\t\t\t: undefined;\n\t\tif (next === undefined) return;\n\t\tevent.preventDefault();\n\t\tcontrols[loop ? (next + controls.length) % controls.length : next]?.focus();\n\t}\n</script>\n\n<SdkPagination\n\trole=\"navigation\"\n\taria-label=\"分页\"\n\tdata-slot=\"pagination\"\n\tdata-pagination-root=\"\"\n\tdata-orientation={orientation}\n\t{page}\n\ttotal={count}\n\tpageSize={perPage}\n\tsiblings={siblingCount}\n\tonPageChange={(next) => {\n\t\tpage = next;\n\t\tonPageChange?.(next);\n\t}}\n\tclass={cn(\"mx-auto flex w-full justify-center\", className)}\n\tstyle={style && typeof style === \"object\" ? styleToString(style) : style}\n\t{...restProps as Record<string, unknown>}\n>\n\t{#snippet render({ props, state })}\n\t\t{@const pages = state.items.map((item) =>\n\t\t\ttypeof item === \"number\"\n\t\t\t\t? { type: \"page\" as const, value: item, key: `page-${item}` }\n\t\t\t\t: { type: \"ellipsis\" as const, key: item }\n\t\t)}\n\t\t{@const range = {\n\t\t\tstart: (state.page - 1) * perPage + 1,\n\t\t\tend: Math.min(state.page * perPage, count),\n\t\t}}\n\t\t{#if child}\n\t\t\t{@render child({\n\t\t\t\tprops: { ...props, ...refProps, onkeydown: keydown },\n\t\t\t\tpages,\n\t\t\t\trange,\n\t\t\t\tcurrentPage: state.page,\n\t\t\t})}\n\t\t{:else}\n\t\t\t<div {...props} {...refProps} onkeydown={keydown}>\n\t\t\t\t{@render children?.({ pages, range, currentPage: state.page })}\n\t\t\t</div>\n\t\t{/if}\n\t{/snippet}\n</SdkPagination>\n",
			"type": "registry:file",
			"target": "pagination/pagination.svelte"
