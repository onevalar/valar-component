{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "issue-composer",
	"title": "Issue Composer 问题编辑弹窗",
	"type": "registry:ui",
	"description": "紧凑和展开两种布局的创建表单，包含标题、描述、可搜索的状态与优先级选择，以及连续创建。",
