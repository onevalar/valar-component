				}
			],
			"accessibility": [
				"打开聚焦标题，关闭恢复到触发器",
				"状态和优先级可用键盘选择，空标题错误可被读出"
			],
			"responsive": [
				"窄屏保留 12 px 侧边间距，长描述在编辑区滚动"
			],
			"related": [
