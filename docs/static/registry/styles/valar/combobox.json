{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "combobox",
	"title": "Combobox 搜索选择",
	"type": "registry:ui",
	"description": "在浮层中搜索并选择一个或多个选项，支持分组和异步数据。",
	"dependencies": [
		"bits-ui"
	],
