		"button"
	],
	"meta": {
		"valar": {
			"keywords": [
				"搜索选择",
				"自动完成",
				"负责人",
				"标签",
				"combobox"
			],
			"whenToUse": [
				"选择负责人、项目或多个标签",
				"通过名称或别名查找选项"
			],
			"whenNotToUse": [
				{
					"case": "执行命令或跳转页面",
					"use": "command"
				},
