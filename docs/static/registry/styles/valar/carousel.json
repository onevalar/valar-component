			"content": "<script lang=\"ts\">\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { Button, type Props } from \"$UI$/button/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\timport { getEmblaContext } from \"./context.js\";\n\timport type { WithoutChildren } from \"bits-ui\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tvariant,\n\t\tsize = \"icon-sm\",\n\t\tlabel = \"上一张\",\n\t\t...restProps\n\t}: WithoutChildren<Props> & {\n\t\t/** Screen reader text. */\n\t\tlabel?: string;\n\t} = $props();\n\n\tconst emblaCtx = getEmblaContext(\"<Carousel.Previous/>\");\n\tconst isMedia = $derived(emblaCtx.appearance === \"media\");\n</script>\n\n<Button\n\tdata-slot=\"carousel-previous\"\n\tvariant={variant ?? (isMedia ? \"ghost\" : \"outline\")}\n\t{size}\n\taria-disabled={!emblaCtx.canScrollPrev}\n\tdisabled={!isMedia && !emblaCtx.canScrollPrev}\n\tclass={cn(\n\t\t\"touch-manipulation\",\n\t\tisMedia\n\t\t\t? \"size-7 shrink-0\"\n\t\t\t: \"rounded-full absolute\",\n\t\t!isMedia && (emblaCtx.orientation === \"horizontal\"\n\t\t\t? \"inset-y-0 -start-12 my-auto\"\n\t\t\t: \"start-1/2 -top-12 -translate-x-1/2 rotate-90\"),\n\t\tclassName\n\t)}\n\tonclick={emblaCtx.scrollPrev}\n\tonkeydown={isMedia ? undefined : emblaCtx.handleKeyDown}\n\t{...restProps}\n\tbind:ref\n>\n\t{#if isMedia}\n\t\t<IconPlaceholder\n\t\t\tlucide=\"ArrowUpIcon\"\n\t\t\ttabler=\"IconArrowUp\"\n\t\t\thugeicons=\"ArrowUp01Icon\"\n\t\t\tphosphor=\"ArrowUpIcon\"\n\t\t\tremixicon=\"RiArrowUpLine\"\n\t\t\tclass=\"size-3.5 text-[color:lch(19.588%_1.25_282)] dark:text-[color:lch(90.451%_1.2_272)]\"\n\t\t/>\n\t{:else}\n\t\t<IconPlaceholder\n\t\t\tlucide=\"ChevronLeftIcon\"\n\t\t\ttabler=\"IconChevronLeft\"\n\t\t\thugeicons=\"ArrowLeft01Icon\"\n\t\t\tphosphor=\"CaretLeftIcon\"\n\t\t\tremixicon=\"RiArrowLeftSLine\"\n\t\t\tclass=\"cn-rtl-flip\"\n\t\t/>\n\t{/if}\n\t<span class=\"sr-only\">{label}</span>\n</Button>\n",
