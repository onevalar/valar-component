			"content": "<script lang=\"ts\">\n\timport { Dialog as SheetPrimitive } from \"bits-ui\";\n\timport { cn } from \"$UTILS$.js\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\t...restProps\n\t}: SheetPrimitive.OverlayProps = $props();\n</script>\n\n<SheetPrimitive.Overlay\n\tbind:ref\n\tdata-slot=\"sheet-overlay\"\n\tclass={cn(\n\t\t\"bg-black/10 supports-backdrop-filter:backdrop-blur-xs fixed inset-0 z-50 duration-100 motion-reduce:animate-none! data-open:animate-in data-open:fade-in-0 data-closed:animate-out data-closed:fade-out-0\",\n\t\tclassName\n\t)}\n\t{...restProps}\n/>\n",
			"type": "registry:file",
			"target": "sheet/sheet-overlay.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { tick } from \"svelte\";\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\topen = $bindable(false),\n\t\tclass: className,\n\t\tlabel,\n\t\ttrigger,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLElement>> & {\n\t\topen?: boolean;\n\t\tlabel: string;\n\t\t/** Receives focus when the panel closes from an interaction inside it. */\n\t\ttrigger?: HTMLElement | null;\n\t} = $props();\n\n\tasync function close() {\n\t\tconst restoreFocus = ref?.contains(ref.ownerDocument.activeElement);\n\t\topen = false;\n\t\tif (restoreFocus) {\n\t\t\tawait tick();\n\t\t\tif (!open) trigger?.focus({ preventScroll: true });\n\t\t}\n\t}\n\n\t// Handle this after nested Bits UI layers have had a chance to dismiss.\n\t$effect(() => {\n\t\tif (!open || !ref) return;\n\t\tconst section = ref;\n\t\tconst view = section.ownerDocument.defaultView;\n\t\tfunction handleEscape(event: KeyboardEvent) {\n\t\t\tif (\n\t\t\t\tevent.key !== \"Escape\" ||\n\t\t\t\tevent.defaultPrevented ||\n\t\t\t\tevent.isComposing ||\n\t\t\t\t!(event.target instanceof Node) ||\n\t\t\t\t!section.contains(event.target)\n\t\t\t)\n\t\t\t\treturn;\n\t\t\tevent.preventDefault();\n\t\t\tvoid close();\n\t\t}\n\t\tview?.addEventListener(\"keydown\", handleEscape);\n\t\treturn () => view?.removeEventListener(\"keydown\", handleEscape);\n\t});\n</script>\n\n<section\n\tbind:this={ref}\n\taria-label={label}\n\tdata-slot=\"sheet-panel\"\n\tdata-state={open ? \"open\" : \"closed\"}\n\thidden={!open}\n\tclass={cn(\"text-foreground relative flex w-full min-h-0 min-w-0 max-w-[400px] flex-col overflow-hidden ps-1 gap-0 bg-background shadow-none data-[side=left]:w-full data-[side=right]:w-full data-[side=left]:sm:max-w-[400px] data-[side=right]:sm:max-w-[400px] motion-reduce:animate-none! **:data-[slot=sheet-header]:gap-1 **:data-[slot=sheet-header]:rounded-[10px] **:data-[slot=sheet-header]:border-[0.5px] **:data-[slot=sheet-header]:border-[color:lch(91.9%_0_282)] **:data-[slot=sheet-header]:bg-[lch(100%_0_282)] **:data-[slot=sheet-header]:p-3 **:data-[slot=sheet-header]:shadow-[0_3px_6px_-2px_rgb(0_0_0_/_2%),0_1px_1px_rgb(0_0_0_/_4%)] dark:**:data-[slot=sheet-header]:border-[color:lch(16.793%_1.93_272)] dark:**:data-[slot=sheet-header]:bg-[lch(9.232%_.85_272)] dark:**:data-[slot=sheet-header]:shadow-[0_0.5px_1px_1px_rgb(0_0_0_/_30%)] **:data-[slot=sheet-title]:text-[15px]/[23px] **:data-[slot=sheet-title]:font-semibold data-[state=closed]:hidden\", className)}\n\t{...restProps}\n>\n\t{#if open}\n\t\t<div data-slot=\"sheet-panel-scroll\" class=\"min-h-0 min-w-0 flex-1 overflow-x-hidden overflow-y-auto overscroll-y-contain py-1 pe-[11px]\">\n\t\t\t{@render children?.()}\n\t\t</div>\n\t{/if}\n</section>\n",
			"type": "registry:file",
