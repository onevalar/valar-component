		{
			"content": "<script lang=\"ts\" module>\n\timport { tv, type VariantProps } from \"tailwind-variants\";\n\n\texport const itemVariants = tv({\n\t\tbase: \"rounded-lg border text-sm [a[href]:not([aria-disabled=true])]:hover:bg-muted [button:enabled]:hover:bg-muted aria-disabled:opacity-50 disabled:opacity-50 group/item flex w-full min-w-0 flex-wrap items-center transition-colors duration-150 outline-none focus-visible:outline-1 focus-visible:-outline-offset-1 focus-visible:outline-ring motion-reduce:transition-none\",\n\t\tvariants: {\n\t\t\tvariant: {\n\t\t\t\tdefault: \"border-transparent\",\n\t\t\t\toutline: \"border-border\",\n\t\t\t\tmuted: \"bg-muted/50 border-transparent\",\n\t\t\t},\n\t\t\tsize: {\n\t\t\t\tdefault: \"gap-2.5 px-3 py-2.5\",\n\t\t\t\tsm: \"gap-2.5 px-3 py-2.5\",\n\t\t\t\txs: \"gap-2 px-2.5 py-2 in-data-[slot=dropdown-menu-content]:p-0\",\n\t\t\t},\n\t\t},\n\t\tdefaultVariants: {\n\t\t\tvariant: \"default\",\n\t\t\tsize: \"default\",\n\t\t},\n\t});\n\n\texport type ItemSize = VariantProps<typeof itemVariants>[\"size\"];\n\texport type ItemVariant = VariantProps<typeof itemVariants>[\"variant\"];\n</script>\n\n<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { Snippet } from \"svelte\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tappearance = \"default\",\n\t\tchild,\n\t\tvariant,\n\t\tsize,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\tappearance?: \"default\" | \"issue-row\";\n\t\tchild?: Snippet<[{ props: Record<string, unknown> }]>;\n\t\tvariant?: ItemVariant;\n\t\tsize?: ItemSize;\n\t} = $props();\n\n\tconst mergedProps = $derived({\n\t\tclass: cn(\n\t\t\tappearance === \"issue-row\"\n\t\t\t\t? \"relative isolate min-h-11 gap-2 rounded-[8px] px-2 text-left sm:px-4 before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:rounded-[inherit] before:transition-colors before:duration-150 dark:before:duration-0 motion-reduce:before:duration-0 [a[href]:not([aria-disabled=true])]:hover:before:bg-[lch(94.44%_.5_282)] dark:[a[href]:not([aria-disabled=true])]:hover:before:bg-[lch(9.345%_.85_272)] [button:enabled]:hover:before:bg-[lch(94.44%_.5_282)] dark:[button:enabled]:hover:before:bg-[lch(9.345%_.85_272)] aria-current:before:bg-[lch(94.44%_.5_282)] dark:aria-current:before:bg-[lch(9.345%_.85_272)] aria-disabled:opacity-50 focus-visible:outline-solid focus-visible:outline-1 focus-visible:-outline-offset-1 focus-visible:outline-ring [&>[data-slot=item-media]]:translate-y-0 [&>[data-slot=item-media]]:self-center [&>[data-slot=item-content]]:min-w-0 [&>[data-slot=item-content]]:flex-row! [&>[data-slot=item-content]]:items-center [&>[data-slot=item-content]]:gap-2 [&_[data-slot=item-title]]:block! [&_[data-slot=item-title]]:min-w-0 [&_[data-slot=item-title]]:truncate [&_[data-slot=item-title]]:text-[13px]/[19.5px] [&_[data-slot=item-title]]:font-medium [&_[data-slot=item-title]]:text-[color:lch(9.794%_0_282)] dark:[&_[data-slot=item-title]]:text-white [&_[data-slot=item-description]]:shrink-0 [&_[data-slot=item-description]]:text-[13px]/[19.5px] [&_[data-slot=item-description]]:font-[450]! [&_[data-slot=item-description]]:text-[color:lch(39.176%_1.25_282)] dark:[&_[data-slot=item-description]]:text-[color:lch(61.803%_1.2_272)] [&>[data-slot=item-actions]]:ms-auto [&>[data-slot=item-actions]]:shrink-0 [&>[data-slot=item-actions]]:text-xs [&>[data-slot=item-actions]]:font-[450] [&>[data-slot=item-actions]]:text-[color:lch(39.176%_1.25_282)] dark:[&>[data-slot=item-actions]]:text-[color:lch(61.803%_1.2_272)] group/item flex w-full items-center\"\n\t\t\t\t: itemVariants({ variant, size }),\n\t\t\tclassName\n\t\t),\n\t\t\"data-slot\": \"item\",\n\t\t\"data-appearance\": appearance,\n\t\t\"data-variant\": variant,\n\t\t\"data-size\": size,\n\t\t...restProps,\n\t});\n</script>\n\n{#if child}\n\t{@render child({ props: mergedProps })}\n{:else}\n\t<div bind:this={ref} {...mergedProps}>\n\t\t{@render mergedProps.children?.()}\n\t</div>\n{/if}\n",
