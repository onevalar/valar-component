	"files": [
		{
			"content": "# Avatar 设计规范\n\n- 每个 Avatar 都放 `Avatar.Image` 和 `Avatar.Fallback`：图片加载失败或没有图片时显示 Fallback（姓名首字或图标）。\n- `Avatar.Image` 必须有 `alt`，写人名或账号名；旁边已有姓名文字时写 `alt=\"\"`（检查规则 `valar/image-alt`）。\n- 尺寸只用 `size` 属性（`sm`、`default`、`lg`），不要用 `class` 写 `size-*`。\n- 订阅者姓名旁可用 `appearance=\"subscriber\"` 显示 18 px 头像。姓名缩写的底色通过 `--valar-avatar-subscriber-color` 设置。\n- 在线状态等标记用 `Avatar.Badge`，并另外用文字或 `aria-label` 表达状态，不要只靠圆点颜色；多个头像用 `Avatar.Group`，超出部分用 `Avatar.GroupCount` 显示数量。\n- 设置成员列表用 `appearance=\"member\"`（24 px，无外描边，缩写 11 px）。多人头像保持顺序；布局空间不足时组内换行，溢出计数提供可读名称。\n",
			"type": "registry:file",
			"target": "avatar/RULES.md"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLSpanElement>> = $props();\n</script>\n\n<span\n\tbind:this={ref}\n\tdata-slot=\"avatar-badge\"\n\tclass={cn(\n\t\t\"bg-primary text-primary-foreground ring-background absolute right-0 bottom-0 z-10 inline-flex items-center justify-center rounded-full bg-blend-color ring-2 select-none\",\n\t\t\"group-data-[size=sm]/avatar:size-2 group-data-[size=sm]/avatar:[&>svg]:hidden\",\n\t\t\"group-data-[size=default]/avatar:size-2.5 group-data-[size=default]/avatar:[&>svg]:size-2\",\n\t\t\"group-data-[size=lg]/avatar:size-3 group-data-[size=lg]/avatar:[&>svg]:size-2\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</span>\n",
			"type": "registry:file",
			"target": "avatar/avatar-badge.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Avatar as AvatarPrimitive } from \"bits-ui\";\n\timport { styleToString } from \"svelte-toolbelt\";\n\timport { createAttachmentKey } from \"svelte/attachments\";\n\timport { cn } from \"$UTILS$.js\";\n\timport { useAvatarBackend } from \"./context.js\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchild,\n\t\tchildren,\n\t\tstyle,\n\t\t...restProps\n\t}: AvatarPrimitive.FallbackProps = $props();\n\tconst backend = useAvatarBackend();\n\tconst status = $derived(backend?.status());\n\tconst elementStyle = $derived(typeof style === \"object\" && style ? styleToString(style) : style);\n\tconst classes = $derived(\n\t\tcn(\n\t\t\t\"bg-muted text-muted-foreground rounded-full flex size-full items-center justify-center text-sm group-data-[size=sm]/avatar:text-xs\",\n\t\t\tclassName\n\t\t)\n\t);\n\tconst refProps = {\n\t\t[createAttachmentKey()]: (element: HTMLSpanElement) => {\n\t\t\tref = element;\n\t\t\treturn () => {\n\t\t\t\tif (ref === element) ref = null;\n\t\t\t};\n\t\t},\n\t};\n</script>\n\n{#if !backend || backend.legacy()}\n\t<AvatarPrimitive.Fallback\n\t\tbind:ref\n\t\t{child}\n\t\t{children}\n\t\tdata-slot=\"avatar-fallback\"\n\t\tclass={classes}\n\t\t{style}\n\t\t{...restProps}\n\t/>\n{:else}\n\t<!-- Valar keeps the fallback DOM and ref while the SDK image is loaded. -->\n\t{@const attributes = {\n\t\t...refProps,\n\t\t\"data-slot\": \"avatar-fallback\",\n\t\t\"data-avatar-fallback\": \"\",\n\t\tclass: classes,\n\t\t...restProps,\n\t\t\"data-status\": status,\n\t\tstyle: status === \"loaded\" ? `${elementStyle ?? \"\"};display:none` : elementStyle,\n\t}}\n\t{#if child}\n\t\t{@render child({ props: attributes })}\n\t{:else}\n\t\t<span {...attributes}>{@render children?.()}</span>\n\t{/if}\n{/if}\n",
			"type": "registry:file",
			"target": "avatar/avatar-fallback.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"avatar-group-count\"\n\tclass={cn(\n\t\t\"bg-muted text-muted-foreground size-8 rounded-full text-sm group-has-data-[size=lg]/avatar-group:size-10 group-has-data-[size=sm]/avatar-group:size-6 [&>svg]:size-4 group-has-data-[size=lg]/avatar-group:[&>svg]:size-5 group-has-data-[size=sm]/avatar-group:[&>svg]:size-3 relative flex shrink-0 items-center justify-center ring-2 ring-background\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "avatar/avatar-group-count.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"avatar-group\"\n\tclass={cn(\n\t\t\"group/avatar-group flex max-w-full flex-wrap gap-y-1 ps-2 *:-ms-2 *:data-[slot=avatar]:ring-2 *:data-[slot=avatar]:ring-background\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "avatar/avatar-group.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { AvatarImage as SdkImage } from \"@ui-sdk/svelte/avatar\";\n\timport { Avatar as AvatarPrimitive } from \"bits-ui\";\n\timport { styleToString } from \"svelte-toolbelt\";\n\timport { createAttachmentKey } from \"svelte/attachments\";\n\timport { cn } from \"$UTILS$.js\";\n\timport { useAvatarBackend } from \"./context.js\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchild,\n\t\tchildren,\n\t\talt,\n\t\tstyle,\n\t\t...restProps\n\t}: AvatarPrimitive.ImageProps = $props();\n\tconst backend = useAvatarBackend();\n\tconst classes = $derived(cn(\"rounded-full aspect-square size-full object-cover\", className));\n\tconst elementStyle = $derived(typeof style === \"object\" && style ? styleToString(style) : style);\n\tconst refProps = {\n\t\t[createAttachmentKey()]: (element: HTMLImageElement) => {\n\t\t\tref = element;\n\t\t\treturn () => {\n\t\t\t\tif (ref === element) ref = null;\n\t\t\t};\n\t\t},\n\t};\n</script>\n\n{#if !backend || backend.legacy()}\n\t<AvatarPrimitive.Image\n\t\tbind:ref\n\t\t{child}\n\t\t{children}\n\t\t{alt}\n\t\tdata-slot=\"avatar-image\"\n\t\tclass={classes}\n\t\t{style}\n\t\t{...restProps}\n\t/>\n{:else}\n\t<SdkImage\n\t\t{...refProps}\n\t\t{alt}\n\t\tdata-slot=\"avatar-image\"\n\t\tdata-avatar-image=\"\"\n\t\tclass={classes}\n\t\t{...restProps}\n\t>\n\t\t{#snippet render({ props, state })}\n\t\t\t{@const attributes = {\n\t\t\t\t...props,\n\t\t\t\t\"data-status\": state.loadingStatus === \"idle\" ? \"loading\" : state.loadingStatus,\n\t\t\t\tstyle: state.loadingStatus === \"loaded\" ? elementStyle : `${elementStyle ?? \"\"};display:none`,\n\t\t\t}}\n\t\t\t{#if child}\n\t\t\t\t{@render child({ props: attributes })}\n\t\t\t{:else}\n\t\t\t\t<img {...attributes} {alt} />\n\t\t\t{/if}\n\t\t{/snippet}\n\t</SdkImage>\n{/if}\n",
			"type": "registry:file",
			"target": "avatar/avatar-image.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Avatar as SdkAvatar, type AvatarLoadingStatus } from \"@ui-sdk/svelte/avatar\";\n\timport { Avatar as AvatarPrimitive } from \"bits-ui\";\n\timport { untrack } from \"svelte\";\n\timport { styleToString } from \"svelte-toolbelt\";\n\timport { createAttachmentKey } from \"svelte/attachments\";\n\timport { cn } from \"$UTILS$.js\";\n\timport { setAvatarBackend } from \"./context.js\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tloadingStatus = $bindable(),\n\t\tdelayMs,\n\t\tonLoadingStatusChange,\n\t\tchild,\n\t\tchildren,\n\t\tsize = \"default\",\n\t\tappearance = \"default\",\n\t\tclass: className,\n\t\tstyle,\n\t\t...restProps\n\t}: AvatarPrimitive.RootProps & {\n\t\tsize?: \"default\" | \"sm\" | \"lg\";\n\t\tappearance?: \"default\" | \"subscriber\" | \"member\";\n\t} = $props();\n\n\t// SDK keeps a loaded image's status while its next source loads. Keep Bits\n\t// for callers that observe every loading transition or control the state/delay.\n\tconst callerSetsStatus = untrack(() => loadingStatus !== undefined);\n\tconst legacy = $derived(callerSetsStatus || !!onLoadingStatusChange || !!delayMs || !!child);\n\tsetAvatarBackend(() => legacy, () => loadingStatus ?? \"loading\");\n\tconst classes = $derived(\n\t\tcn(\n\t\t\t\"size-8 rounded-full after:rounded-full data-[size=lg]:size-10 data-[size=sm]:size-6 group/avatar relative flex shrink-0 select-none after:absolute after:inset-0 after:border after:border-border after:mix-blend-darken dark:after:mix-blend-lighten\",\n\t\t\tappearance === \"subscriber\" && \"data-[appearance=subscriber]:size-[18px]! after:hidden [&>[data-slot=avatar-fallback]]:bg-[color:var(--valar-avatar-subscriber-color,lch(70%_60_220))] [&>[data-slot=avatar-fallback]]:text-[9px]/none [&>[data-slot=avatar-fallback]]:font-medium [&>[data-slot=avatar-fallback]]:text-white\",\n\t\t\tappearance === \"member\" && \"data-[appearance=member]:size-6! after:hidden [&>[data-slot=avatar-fallback]]:text-[11px]/none [&>[data-slot=avatar-fallback]]:font-normal\",\n\t\t\tclassName\n\t\t)\n\t);\n\tconst refProps = {\n\t\t[createAttachmentKey()]: (element: HTMLDivElement) => {\n\t\t\tref = element;\n\t\t\treturn () => {\n\t\t\t\tif (ref === element) ref = null;\n\t\t\t};\n\t\t},\n\t};\n\tfunction statusChange(status: AvatarLoadingStatus) {\n\t\tconst next = status === \"idle\" ? \"loading\" : status;\n\t\tif (next === (loadingStatus ?? \"loading\")) return;\n\t\tloadingStatus = next;\n\t\tonLoadingStatusChange?.(next);\n\t}\n</script>\n\n{#if legacy}\n\t<AvatarPrimitive.Root\n\t\tbind:ref\n\t\tbind:loadingStatus={() => loadingStatus ?? \"loading\", (next) => (loadingStatus = next)}\n\t\t{delayMs}\n\t\t{onLoadingStatusChange}\n\t\t{child}\n\t\t{children}\n\t\tdata-slot=\"avatar\"\n\t\tdata-size={size}\n\t\tdata-appearance={appearance}\n\t\tclass={classes}\n\t\t{style}\n\t\t{...restProps}\n\t/>\n{:else}\n\t<SdkAvatar\n\t\tdata-slot=\"avatar\"\n\t\tdata-avatar-root=\"\"\n\t\tdata-size={size}\n\t\tdata-appearance={appearance}\n\t\tclass={classes}\n\t\tstyle={style && typeof style === \"object\" ? styleToString(style) : style}\n\t\t{...restProps as Record<string, unknown>}\n\t\tonLoadingStatusChange={statusChange}\n\t>\n\t\t{#snippet render({ props, state })}\n\t\t\t<div\n\t\t\t\t{...props}\n\t\t\t\t{...refProps}\n\t\t\t\tdata-status={state.loadingStatus === \"idle\" ? \"loading\" : state.loadingStatus}\n\t\t\t>\n\t\t\t\t{@render children?.()}\n\t\t\t</div>\n\t\t{/snippet}\n\t</SdkAvatar>\n{/if}\n",
			"type": "registry:file",
			"target": "avatar/avatar.svelte"
		},
		{
			"content": "import { getContext, setContext } from \"svelte\";\n\nconst avatarBackend = Symbol(\"avatar-backend\");\n\nexport function setAvatarBackend(legacy: () => boolean, status: () => \"loading\" | \"loaded\" | \"error\") {\n\tsetContext(avatarBackend, { legacy, status });\n}\n\nexport function useAvatarBackend() {\n\treturn getContext<{\n\t\tlegacy: () => boolean;\n\t\tstatus: () => \"loading\" | \"loaded\" | \"error\";\n\t}>(avatarBackend);\n}\n",
			"type": "registry:file",
			"target": "avatar/context.ts"
		},
		{
			"content": "import Badge from \"./avatar-badge.svelte\";\nimport Fallback from \"./avatar-fallback.svelte\";\nimport GroupCount from \"./avatar-group-count.svelte\";\nimport Group from \"./avatar-group.svelte\";\nimport Image from \"./avatar-image.svelte\";\nimport Root from \"./avatar.svelte\";\n\nexport {\n\tRoot,\n\tImage,\n\tFallback,\n\tBadge,\n\tGroup,\n\tGroupCount,\n\t//\n\tRoot as Avatar,\n\tImage as AvatarImage,\n\tFallback as AvatarFallback,\n\tBadge as AvatarBadge,\n\tGroup as AvatarGroup,\n\tGroupCount as AvatarGroupCount,\n};\n",
			"type": "registry:file",
			"target": "avatar/index.ts"
		}
	]
