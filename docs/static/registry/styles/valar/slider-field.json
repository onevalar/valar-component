{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "slider-field",
	"title": "Slider Field 滑块数值",
	"type": "registry:ui",
	"description": "滑块搭配数字输入框或只读数值。",
	"registryDependencies": [
		"number-field",
		"slider"
	],
	"meta": {
		"valar": {
			"keywords": [
				"滑块",
				"slider",
				"数值",
				"范围",
				"参数调节"
			],
			"whenToUse": [
				"在已知范围内调整数值，并需要精确输入或显示当前值"
			],
			"whenNotToUse": [
				{
					"case": "没有明确范围的数字",
					"use": "number-field"
				},
				{
					"case": "无需显示当前数值",
					"use": "slider"
				}
			],
			"accessibility": [
				"可见标签命名滑块和可编辑输入框",
				"读数模式的键盘焦点停留在滑块",
				"超出范围的输入标为无效而不是静默截断"
			],
			"responsive": [
				"读数模式下滑块与数值作为一组，空间不足时换到标签下方"
			],
			"related": [
				"slider",
				"number-field",
				"field"
			]
		}
	},
	"files": [
		{
			"content": "# Slider Field 设计规范\n\n- 用于有明确范围、需要查看或精确输入数值的参数，例如尺寸、透明度和主题对比度。无需显示数字时用 Slider，没有范围的数字用 Number Field。\n- `label` 必填。默认外观用它命名滑块、数字输入框和加减按钮。读数外观将可见标签与滑块关联。\n- `appearance=\"readout\"` 用于设置项。控制组宽 250 px、高 32 px，读数与滑块一起换行。读数不参与 Tab 轮转，焦点提示保留在滑块内侧。\n- 单位写在 `unit`（如 `unit=\"px\"`），它只显示在数字后面，不进入值；值始终是数字。\n- 必须给出 `min`、`max`、`step`。超出范围或无法解析的输入会被标为无效并保持上一个有效值，不要另外写截断逻辑。\n- 放在表单中提交时设 `name`，提交的是纯数字。\n",
			"type": "registry:file",
			"target": "slider-field/RULES.md"
		},
		{
			"content": "export { default as SliderField, type SliderFieldProps } from \"./slider-field.svelte\";\n",
			"type": "registry:file",
			"target": "slider-field/index.ts"
		},
		{
			"content": "<script lang=\"ts\" module>\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\texport type SliderFieldProps = Omit<HTMLAttributes<HTMLDivElement>, \"children\"> & {\n\t\t/** Visible label for the slider and the editable number input, when present. */\n\t\tlabel: string;\n\t\t/** The settings row uses a read-only numeric display instead of a number input. */\n\t\tappearance?: \"default\" | \"readout\";\n\t\tvalue?: number;\n\t\tmin?: number;\n\t\tmax?: number;\n\t\tstep?: number;\n\t\t/** Shown after the number, e.g. \"px\". Not part of the value. */\n\t\tunit?: string;\n\t\tdisabled?: boolean;\n\t\t/** Form field name. The value is submitted as a plain number. */\n\t\tname?: string;\n\t\tonValueChange?: (value: number) => void;\n\t};\n</script>\n\n<script lang=\"ts\">\n\timport { NumberField } from \"$UI$/number-field/index.js\";\n\timport { Slider } from \"$UI$/slider/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\n\tlet {\n\t\tlabel,\n\t\tappearance = \"default\",\n\t\tvalue = $bindable(0),\n\t\tmin = 0,\n\t\tmax = 100,\n\t\tstep = 1,\n\t\tunit,\n\t\tdisabled = false,\n\t\tname,\n\t\tonValueChange,\n\t\tid: idProp,\n\t\tclass: className,\n\t\t...restProps\n\t}: SliderFieldProps = $props();\n\tconst generated = $props.id();\n\tconst id = $derived(idProp ?? generated);\n\n\tfunction set(next: number | undefined) {\n\t\t// An emptied or invalid number box keeps the last value instead of becoming 0.\n\t\t// Out-of-range typing is shown as invalid by the number box until it is corrected.\n\t\tif (next === undefined || !Number.isFinite(next) || next < min || next > max) return;\n\t\tif (Object.is(next, value)) return;\n\t\tvalue = next;\n\t\tonValueChange?.(next);\n\t}\n</script>\n\n{#snippet slider(settings: boolean)}\n\t<Slider\n\t\ttype=\"single\"\n\t\tappearance={settings ? \"settings\" : \"default\"}\n\t\t{value}\n\t\tonValueChange={set}\n\t\t{min}\n\t\t{max}\n\t\t{step}\n\t\t{disabled}\n\t\taria-label={settings ? undefined : label}\n\t\taria-labelledby={settings ? `${id}-label` : undefined}\n\t\taria-valuetext={settings && unit ? `${value} ${unit}` : undefined}\n\t/>\n{/snippet}\n\n{#if appearance === \"default\"}\n\t<div\n\t\tdata-slot=\"slider-field\"\n\t\tdata-appearance=\"default\"\n\t\tdata-disabled={disabled || undefined}\n\t\tclass={cn(\n\t\t\t\"grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2\",\n\t\t\t\"\",\n\t\t\tclassName\n\t\t)}\n\t\t{...restProps}\n\t>\n\t\t<label for={`${id}-input`} class=\"col-span-2 text-sm font-medium\">{label}</label>\n\t\t{@render slider(false)}\n\t\t<div class=\"flex items-center gap-1.5\">\n\t\t\t<NumberField\n\t\t\t\tid={`${id}-input`}\n\t\t\t\t{name}\n\t\t\t\t{value}\n\t\t\t\tonValueChange={set}\n\t\t\t\t{min}\n\t\t\t\t{max}\n\t\t\t\t{step}\n\t\t\t\t{disabled}\n\t\t\t\tclass={cn(\"w-32\", \"\")}\n\t\t\t\tdecrementLabel={`减小${label}`}\n\t\t\t\tincrementLabel={`增大${label}`}\n\t\t\t/>\n\t\t\t{#if unit}<span class=\"text-xs text-muted-foreground\">{unit}</span>{/if}\n\t\t</div>\n\t</div>\n{:else}\n\t<div\n\t\tdata-slot=\"slider-field\"\n\t\tdata-appearance=\"readout\"\n\t\tdata-disabled={disabled || undefined}\n\t\tclass={cn(\n\t\t\t\"flex min-h-16 w-full max-w-[640px] min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-1 px-4 py-2\",\n\t\t\tclassName\n\t\t)}\n\t\t{...restProps}\n\t>\n\t\t<span\n\t\t\tid={`${id}-label`}\n\t\t\tclass=\"min-w-0 [overflow-wrap:anywhere] text-[13px]/[15.5px] font-[450] text-[#5e5e5f] dark:text-[#9a9c9a]\"\n\t\t>\n\t\t\t{label}\n\t\t</span>\n\t\t<div\n\t\t\tdata-slot=\"slider-field-control\"\n\t\t\tclass=\"flex h-8 w-[250px] max-w-full min-w-0 items-center gap-2\"\n\t\t>\n\t\t\t{@render slider(true)}\n\t\t\t<span\n\t\t\t\tdata-slot=\"slider-field-readout\"\n\t\t\t\tclass=\"shrink-0 ps-1 text-end text-[13px]/[15.5px] font-medium text-[#303031] tabular-nums dark:text-[#e4e5e3]\"\n\t\t\t>\n\t\t\t\t{value}{unit}\n\t\t\t</span>\n\t\t</div>\n\t\t{#if name}<input type=\"hidden\" {name} {value} {disabled} />{/if}\n\t</div>\n{/if}\n",
			"type": "registry:file",
			"target": "slider-field/slider-field.svelte"
		}
	]
}