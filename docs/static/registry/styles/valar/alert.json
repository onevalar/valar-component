{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "alert",
	"title": "Alert 提示条",
	"type": "registry:ui",
	"description": "页面内的提示信息块，用于需要用户注意的状态说明。",
	"devDependencies": [
		"tailwind-variants@^3.3.0"
	],
	"meta": {
		"valar": {
			"keywords": [
				"提示",
				"alert",
				"警告",
				"通知",
				"横幅"
			],
			"whenToUse": [
				"持续显示在页面中的状态或警告"
			],
			"whenNotToUse": [
				{
					"case": "操作后的短暂通知",
					"use": "sonner"
				},
				{
					"case": "需要用户确认",
					"use": "alert-dialog"
				}
			],
			"accessibility": [
				"重要提示使用 role=alert",
				"不只靠颜色区分类型，配合图标和文字"
			],
			"responsive": [
				"窄屏下图标与文字保持对齐，文字可换行"
			],
			"related": [
				"sonner",
				"card"
			]
		}
	},
	"files": [
		{
			"content": "# Alert 设计规范\n\n- Alert 自带 `role=\"alert\"`，插入页面时会被读屏器立即播报；页面加载时就存在、只是说明性质的提示，传 `role=\"status\"` 或改用普通文字、Card。\n- 类型只用 `variant`（`default`、`destructive`），不要自定义背景色；同时配合图标和文字说明，不要只靠颜色区分。\n- 结构用 `Alert.Title` 写要点、`Alert.Description` 写细节和解决办法；图标作为第一个子元素放在 Alert 内；相关操作放进 `Alert.Action`。\n- 操作完成后的短暂反馈用 Sonner，需要用户确认的操作用 Alert Dialog。\n",
			"type": "registry:file",
			"target": "alert/RULES.md"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"alert-action\"\n\tclass={cn(\"row-span-2 row-start-1 self-center\", className)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "alert/alert-action.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"alert-description\"\n\tclass={cn(\n\t\t\"text-[color:lch(40%_1_282)] text-xs/[18px] font-[450] wrap-anywhere dark:text-[color:lch(63.304%_1.425_272)] [&_p:not(:last-child)]:mb-4 [&_a]:underline [&_a]:underline-offset-3 [&_a]:hover:text-foreground\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "alert/alert-description.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"alert-title\"\n\tclass={cn(\n\t\t\"font-medium wrap-anywhere [&_a]:underline [&_a]:underline-offset-3 [&_a]:hover:text-foreground\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "alert/alert-title.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n\timport { type VariantProps, tv } from \"tailwind-variants\";\n\n\texport const alertVariants = tv({\n\t\tbase: \"grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-3 gap-y-0.5 rounded-[10px] px-4 py-4 text-start text-[13px] shadow-[0_0_0_.5px_rgb(0_0_0_/_8.8%),0_3px_6px_-2px_rgb(0_0_0_/_2%),0_1px_1px_rgb(0_0_0_/_4%)] dark:shadow-[0_0_0_.5px_rgb(255_255_255_/_8.3%),0_.5px_1px_1px_rgb(0_0_0_/_30%)] has-[>svg]:grid-cols-[auto_minmax(0,1fr)_auto] has-[>svg]:gap-x-2 *:[svg]:col-start-1 *:[svg]:row-start-1 *:[svg]:row-span-2 *:[svg]:translate-y-0.5 *:[svg]:text-current *:[svg:not([class*='size-'])]:size-4 [&>[data-slot=alert-title]]:col-start-1 [&>[data-slot=alert-title]]:row-start-1 [&>[data-slot=alert-description]]:col-start-1 [&:has(>svg)>[data-slot=alert-title]]:col-start-2 [&:has(>svg)>[data-slot=alert-description]]:col-start-2 [&>[data-slot=alert-action]]:col-start-2 [&:has(>svg)>[data-slot=alert-action]]:col-start-3 group/alert relative w-full\",\n\t\tvariants: {\n\t\t\tvariant: {\n\t\t\t\tdefault: \"bg-[lch(100%_0_282)] text-[color:lch(10%_0_282)] dark:bg-[lch(9.232%_.85_272)] dark:text-[color:lch(100%_0_272)]\",\n\t\t\t\tdestructive: \"bg-[lch(100%_0_282)] text-[color:lch(50%_80_29)] dark:bg-[lch(9.232%_.85_272)] dark:text-[color:lch(80%_80_29)]\",\n\t\t\t},\n\t\t},\n\t\tdefaultVariants: {\n\t\t\tvariant: \"default\",\n\t\t},\n\t});\n\n\texport type AlertVariant = VariantProps<typeof alertVariants>[\"variant\"];\n</script>\n\n<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tvariant = \"default\",\n\t\tappearance,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\tvariant?: AlertVariant;\n\t\tappearance?: \"connection\";\n\t} = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"alert\"\n\tdata-appearance={appearance}\n\trole=\"alert\"\n\tclass={cn(\n\t\tappearance === \"connection\" ? \"inline-flex min-h-6 max-w-full flex-wrap items-center rounded-[12px] bg-transparent text-xs/4 font-medium [--alert-connection-warning:lch(50%_80_29)] [--alert-connection-action:lch(18.888%_1.25_282)] [--alert-connection-hover-ink:lch(9.444%_0_282)] [--alert-connection-hover-bg:rgb(0_0_0_/_6%)] dark:[--alert-connection-warning:lch(80%_80_29)] dark:[--alert-connection-action:lch(90.155%_1.2_272)] dark:[--alert-connection-hover-ink:lch(100%_0_272)] dark:[--alert-connection-hover-bg:lch(10.149%_.689_272)] *:data-[slot=alert-title]:flex *:data-[slot=alert-title]:min-w-[81px] *:data-[slot=alert-title]:shrink-0 *:data-[slot=alert-title]:items-center *:data-[slot=alert-title]:gap-1.5 *:data-[slot=alert-title]:ps-1.5 *:data-[slot=alert-title]:pe-2 *:data-[slot=alert-title]:text-(color:--alert-connection-warning) [&>[data-slot=alert-title]>svg]:size-3.5 *:data-[slot=alert-action]:static [&>[data-slot=alert-action]>button]:h-6 [&>[data-slot=alert-action]>button]:min-w-24 [&>[data-slot=alert-action]>button]:justify-start [&>[data-slot=alert-action]>button]:gap-1.5 [&>[data-slot=alert-action]>button]:rounded-full [&>[data-slot=alert-action]>button]:border-0 [&>[data-slot=alert-action]>button]:bg-transparent [&>[data-slot=alert-action]>button]:ps-1.5 [&>[data-slot=alert-action]>button]:pe-2 [&>[data-slot=alert-action]>button]:text-xs/4 [&>[data-slot=alert-action]>button]:font-medium [&>[data-slot=alert-action]>button]:text-(color:--alert-connection-action) [&>[data-slot=alert-action]>button>svg]:size-3.5 [&>[data-slot=alert-action]>button]:transition-[background-color,color] [&>[data-slot=alert-action]>button]:duration-150 motion-reduce:[&>[data-slot=alert-action]>button]:transition-none [&>[data-slot=alert-action]>button:hover]:bg-(--alert-connection-hover-bg) [&>[data-slot=alert-action]>button:hover]:text-(color:--alert-connection-hover-ink) [&>[data-slot=alert-action]>button:focus-visible]:outline-1 [&>[data-slot=alert-action]>button:focus-visible]:-outline-offset-1 [&>[data-slot=alert-action]>button:focus-visible]:outline-solid [&>[data-slot=alert-action]>button:focus-visible]:outline-ring [&>[data-slot=alert-action]>button:focus-visible]:ring-0 group/alert\" : alertVariants({ variant }),\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "alert/alert.svelte"
		},
		{
			"content": "import Action from \"./alert-action.svelte\";\nimport Description from \"./alert-description.svelte\";\nimport Title from \"./alert-title.svelte\";\nimport Root from \"./alert.svelte\";\nexport { alertVariants, type AlertVariant } from \"./alert.svelte\";\n\nexport {\n\tRoot,\n\tDescription,\n\tTitle,\n\tAction,\n\t//\n\tRoot as Alert,\n\tDescription as AlertDescription,\n\tTitle as AlertTitle,\n\tAction as AlertAction,\n};\n",
			"type": "registry:file",
			"target": "alert/index.ts"
		}
	]
}