{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "radio-group",
	"title": "Radio Group 单选组",
	"type": "registry:ui",
	"description": "从少量互斥选项中选一个，所有选项同时可见。",
	"dependencies": [
		"@ui-sdk/core@0.1.0-beta.17",
		"@ui-sdk/svelte@0.1.0-beta.17",
		"svelte-toolbelt@0.10.6"
	],
	"meta": {
		"valar": {
			"keywords": [
				"单选",
				"radio",
				"单选组",
				"选项"
			],
			"whenToUse": [
				"2–5 个互斥选项，需要用户比较后选择"
			],
			"whenNotToUse": [
				{
					"case": "选项很多",
					"use": "select"
				},
				{
					"case": "可以多选",
					"use": "checkbox"
				},
				{
					"case": "切换视图或模式",
					"use": "tabs"
				}
			],
			"accessibility": [
				"整组有 legend 或 aria-label",
				"方向键在选项间移动"
			],
			"responsive": [
				"窄屏下纵向排列"
			],
			"related": [
				"select",
				"checkbox",
				"toggle-group"
			]
		}
	},
	"files": [
		{
			"content": "# Radio Group 设计规范\n\n- 用于 2–5 个互斥选项且需要一眼看全的场景；选项更多时用 Select，可以多选用 Checkbox，切换视图或模式用 Tabs 或 Toggle Group。\n- 整组要有名称：放在 `Field.Set` 中并用 `Field.Legend` 写组名，或给 `RadioGroup.Root` 设 `aria-label`。\n- 每个 `RadioGroup.Item` 设 `id` 和 `value`，并用 `Field.Label for={id}` 关联可点击的标签（检查规则 `valar/input-label`）；每项放在 `<Field.Field orientation=\"horizontal\">` 中。\n- React 用 `defaultValue` 或 `value`／`onValueChange`；Vue 用 `default-value` 或 `v-model`；Svelte 用 `defaultValue` 或 `bind:value`。选项值使用唯一的非空字符串；Svelte 用 `\"\"` 表示未选中。\n- `name` 必须非空才参与原生提交和 `required` 校验。未选中、选中项被禁用或整组被禁用，不产生表单条目；不再用文本代理提交空字符串。默认值可作为表单重置目标；受控值不设默认值时由宿主处理重置。`form` 可关联外部表单。\n- 用组件的值绑定或回调订阅选择变化，不要依赖表单代理触发原生 `input`／`change`。如果必填项必须提交可用值，禁用当前选中项时清空选中值：原生校验可能通过，但不会提交该选项。\n- 方向用 `orientation` 属性；方向键沿对应轴移动，跳过禁用项，横向遵从元素或祖先的 `dir`。不要给每个选项单独加 Tab 停留。Space 可选择，Enter 不会提交表单；只读组可以移焦但不更改选中项。UI SDK 不提供 Home／End 跳转。\n- 用原生 `<label for>` 关联默认按钮；标签包裹整张卡片时，用 `aria-labelledby` 关联标题、`aria-describedby` 关联说明。自定义非按钮选项不要依赖原生标签激活。旧 Vue `asChild`、可取消的 `select` 事件及 Vue／Svelte `autocomplete` 文本代理接口不再提供。依赖 React／Vue 旧方向 Provider 的用法改为设置 `dir`。\n",
			"type": "registry:file",
			"target": "radio-group/RULES.md"
		},
		{
			"content": "import Item from \"./radio-group-item.svelte\";\nimport Root from \"./radio-group.svelte\";\n\nexport {\n\tRoot,\n\tItem,\n\t//\n\tRoot as RadioGroup,\n\tItem as RadioGroupItem,\n};\n",
			"type": "registry:file",
			"target": "radio-group/index.ts"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Radio, RadioIndicator } from \"@ui-sdk/svelte/radio\";\n\timport { styleToString } from \"svelte-toolbelt\";\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { cn } from \"$UTILS$.js\";\n\timport type { HTMLButtonAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tvalue,\n\t\tdisabled,\n\t\tstyle,\n\t\tonkeydown,\n\t\t...restProps\n\t}: Omit<HTMLButtonAttributes, \"children\" | \"value\" | \"style\"> & {\n\t\tref?: HTMLButtonElement | null;\n\t\tvalue: string;\n\t\tstyle?: string | Record<string, string | number | null | undefined> | null;\n\t} = $props();\n\n\tconst inlineStyle = $derived(style && typeof style === \"object\" ? styleToString(style) : style);\n\tconst keydown: NonNullable<HTMLButtonAttributes[\"onkeydown\"]> = (event) => {\n\t\tonkeydown?.(event);\n\t\tconst { currentTarget, key } = event;\n\t\tconst horizontal =\n\t\t\tcurrentTarget.closest('[data-slot=\"radio-group\"]')?.getAttribute(\"aria-orientation\") ===\n\t\t\t\"horizontal\";\n\t\t// The SDK otherwise handles both arrow axes and submits on Enter.\n\t\tif (\n\t\t\tkey === \"Enter\" ||\n\t\t\t(horizontal\n\t\t\t\t? key === \"ArrowUp\" || key === \"ArrowDown\"\n\t\t\t\t: key === \"ArrowLeft\" || key === \"ArrowRight\")\n\t\t) {\n\t\t\tevent.preventDefault();\n\t\t}\n\t};\n</script>\n\n<Radio\n\t{...restProps}\n\t{value}\n\tdisabled={disabled ?? undefined}\n\tonkeydown={keydown}\n\tstyle={inlineStyle}\n\tclass={cn(\n\t\t\"border-[color:lch(52.04%_0_282)] dark:border-[color:lch(48.72%_1.48_272)] bg-transparent data-checked:bg-primary data-checked:text-primary-foreground dark:data-checked:bg-primary data-checked:border-primary aria-invalid:aria-checked:border-primary aria-invalid:border-destructive focus-visible:border-ring focus-visible:ring-ring aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 flex size-4 rounded-full focus-visible:ring-1 focus-visible:ring-inset aria-invalid:ring-1 aria-invalid:ring-inset group-has-[:focus-visible]/field-label:ring-0 group-has-[:focus-visible]/field-label:not-data-checked:border-input group-has-[:focus-visible]/field-label:data-checked:border-primary transition-colors duration-150 motion-reduce:transition-none group/radio-group-item peer relative aspect-square shrink-0 border outline-none after:absolute after:-inset-x-3 after:-inset-y-2 disabled:cursor-not-allowed disabled:opacity-50\",\n\t\tclassName\n\t)}\n>\n\t{#snippet render({ props, state })}\n\t\t<button\n\t\t\t{...props}\n\t\t\tbind:this={ref}\n\t\t\tdisabled={state.disabled}\n\t\t\tdata-slot=\"radio-group-item\"\n\t\t\tdata-value={value}\n\t\t\tdata-state={state.checked ? \"checked\" : \"unchecked\"}\n\t\t>\n\t\t\t<RadioIndicator keepMounted class=\"flex size-4 items-center justify-center\" aria-hidden=\"true\">\n\t\t\t\t{#snippet render({ props: indicator })}\n\t\t\t\t\t<span {...indicator} data-slot=\"radio-group-indicator\">\n\t\t\t\t\t\t{#if state.checked}\n\t\t\t\t\t\t\t<IconPlaceholder\n\t\t\t\t\t\t\t\tlucide=\"CircleIcon\"\n\t\t\t\t\t\t\t\ttabler=\"IconCircle\"\n\t\t\t\t\t\t\t\thugeicons=\"CircleIcon\"\n\t\t\t\t\t\t\t\tphosphor=\"CircleIcon\"\n\t\t\t\t\t\t\t\tremixicon=\"RiCircleLine\"\n\t\t\t\t\t\t\t\tclass=\"bg-primary-foreground absolute top-1/2 left-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t{/if}\n\t\t\t\t\t</span>\n\t\t\t\t{/snippet}\n\t\t\t</RadioIndicator>\n\t\t</button>\n\t{/snippet}\n</Radio>\n",
			"type": "registry:file",
			"target": "radio-group/radio-group-item.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { RadioGroup as SdkRadioGroup } from \"@ui-sdk/svelte/radio\";\n\timport { untrack, type Snippet } from \"svelte\";\n\timport { styleToString } from \"svelte-toolbelt\";\n\timport { createAttachmentKey, type Attachment } from \"svelte/attachments\";\n\timport { cn } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tvalue = $bindable(),\n\t\tdefaultValue,\n\t\tclass: className,\n\t\tstyle,\n\t\torientation = \"vertical\",\n\t\treadonly,\n\t\tname,\n\t\trequired,\n\t\tonValueChange,\n\t\tchildren,\n\t\tchild,\n\t\t...restProps\n\t}: Omit<HTMLAttributes<HTMLDivElement>, \"style\" | \"children\" | \"defaultValue\"> & {\n\t\tref?: HTMLDivElement | null;\n\t\tvalue?: string;\n\t\tdefaultValue?: string;\n\t\torientation?: \"vertical\" | \"horizontal\";\n\t\treadonly?: boolean;\n\t\tdisabled?: boolean;\n\t\tloop?: boolean;\n\t\tname?: string;\n\t\tform?: string;\n\t\trequired?: boolean;\n\t\tstyle?: string | Record<string, string | number | null | undefined> | null;\n\t\tonValueChange?: (value: string) => void;\n\t\tchildren?: Snippet;\n\t\tchild?: Snippet<[{ props: Record<PropertyKey, unknown> }]>;\n\t} = $props();\n\n\tconst initiallyUncontrolled = untrack(() => value === undefined);\n\tconst inlineStyle = $derived(style && typeof style === \"object\" ? styleToString(style) : style);\n\tconst refKey = createAttachmentKey();\n\tconst attachRef: Attachment<HTMLDivElement> = (element) => {\n\t\tref = element;\n\t\treturn () => {\n\t\t\tif (ref === element) ref = null;\n\t\t};\n\t};\n\n\tfunction update(next: string | null | undefined) {\n\t\tconst selected = next ?? \"\";\n\t\tvalue = selected;\n\t\tonValueChange?.(selected);\n\t}\n</script>\n\n<SdkRadioGroup\n\t{...restProps}\n\tbind:value={() => (value === \"\" ? null : value), update}\n\tdefaultValue={defaultValue === \"\" || (defaultValue === undefined && initiallyUncontrolled)\n\t\t? null\n\t\t: defaultValue}\n\treadOnly={readonly}\n\tname={name || undefined}\n\trequired={Boolean(name) && required}\n\taria-required={required || undefined}\n\taria-orientation={orientation}\n\tdata-orientation={orientation}\n\tstyle={inlineStyle}\n\tclass={cn(\"grid gap-2 w-full\", className)}\n>\n\t{#snippet render({ props })}\n\t\t{#if child}\n\t\t\t{@render child({ props: { ...props, \"data-slot\": \"radio-group\", [refKey]: attachRef } })}\n\t\t{:else}\n\t\t\t<div {...props} bind:this={ref} data-slot=\"radio-group\">\n\t\t\t\t{@render children?.()}\n\t\t\t</div>\n\t\t{/if}\n\t{/snippet}\n</SdkRadioGroup>\n",
			"type": "registry:file",
			"target": "radio-group/radio-group.svelte"
		}
	]
}