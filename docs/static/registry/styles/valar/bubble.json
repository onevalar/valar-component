			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLButtonAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tpressed = false,\n\t\ttype = \"button\",\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLButtonAttributes, HTMLButtonElement> & { pressed?: boolean } = $props();\n</script>\n\n<button\n\tbind:this={ref}\n\t{type}\n\tdata-slot=\"bubble-reaction\"\n\taria-pressed={pressed}\n\tclass={cn(\n\t\t\"h-7 gap-1 rounded-full border-[0.5px] border-border px-2 text-xs text-[color:lch(40%_1_282)] hover:bg-muted dark:text-[color:lch(63.304%_1.425_272)] aria-pressed:border-[lch(84.772%_2.503_282.49)] aria-pressed:bg-[lch(92.222%_5.203_282.49)] dark:aria-pressed:border-[lch(22.165%_18.388_285.615)] dark:aria-pressed:bg-[lch(16.855%_18.028_285.615)] inline-flex min-w-0 shrink-0 items-center justify-center outline-none focus-visible:outline-1 focus-visible:-outline-offset-1 focus-visible:outline-ring disabled:opacity-50\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</button>\n",
