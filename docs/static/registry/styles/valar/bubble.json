			"content": "<script lang=\"ts\" module>\n\timport { tv, type VariantProps } from \"tailwind-variants\";\n\n\texport const bubbleVariants = tv({\n\t\tbase: \"gap-1 data-[align=end]:self-end max-w-[80%] data-[variant=ghost]:max-w-full group-data-[align=end]/message:self-end group/bubble relative flex w-fit min-w-0 flex-col\",\n\t\tvariants: {\n\t\t\tvariant: {\n\t\t\t\tdefault: \"*:data-[slot=bubble-content]:bg-primary *:data-[slot=bubble-content]:text-primary-foreground [&>[data-slot=bubble-content]:is(button,a):hover]:bg-primary/80\",\n\t\t\t\tsecondary: \"*:data-[slot=bubble-content]:bg-secondary *:data-[slot=bubble-content]:text-secondary-foreground [&>[data-slot=bubble-content]:is(button,a):hover]:bg-[color-mix(in_oklch,var(--secondary),var(--foreground)_5%)]\",\n\t\t\t\tmuted: \"*:data-[slot=bubble-content]:bg-muted [&>[data-slot=bubble-content]:is(button,a):hover]:bg-[color-mix(in_oklch,var(--muted),var(--foreground)_5%)]\",\n\t\t\t\ttinted: \"*:data-[slot=bubble-content]:bg-[oklch(from_var(--primary)_0.93_calc(c*0.4)_h)] dark:*:data-[slot=bubble-content]:bg-[oklch(from_var(--primary)_0.3_calc(c*0.4)_h)] *:data-[slot=bubble-content]:text-foreground [&>[data-slot=bubble-content]:is(button,a):hover]:bg-[oklch(from_var(--primary)_0.88_calc(c*0.5)_h)] dark:[&>[data-slot=bubble-content]:is(button,a):hover]:bg-[oklch(from_var(--primary)_0.35_calc(c*0.5)_h)]\",\n\t\t\t\toutline: \"*:data-[slot=bubble-content]:bg-background *:data-[slot=bubble-content]:border-border [&>[data-slot=bubble-content]:is(button,a):hover]:bg-muted [&>[data-slot=bubble-content]:is(button,a):hover]:text-foreground dark:[&>[data-slot=bubble-content]:is(button,a):hover]:bg-input/30\",\n\t\t\t\tghost: \"*:data-[slot=bubble-content]:rounded-none *:data-[slot=bubble-content]:bg-transparent *:data-[slot=bubble-content]:p-0 [&>[data-slot=bubble-content]:is(button,a):hover]:bg-muted [&>[data-slot=bubble-content]:is(button,a):hover]:text-foreground dark:[&>[data-slot=bubble-content]:is(button,a):hover]:bg-muted/50 border-none\",\n\t\t\t\tdestructive: \"*:data-[slot=bubble-content]:bg-destructive/10 dark:*:data-[slot=bubble-content]:bg-destructive/20 *:data-[slot=bubble-content]:text-destructive [&>[data-slot=bubble-content]:is(button,a):hover]:bg-destructive/20 dark:[&>[data-slot=bubble-content]:is(button,a):hover]:bg-destructive/30\",\n\t\t\t},\n\t\t},\n\t\tdefaultVariants: {\n\t\t\tvariant: \"default\",\n\t\t},\n\t});\n\n\texport type BubbleVariant = VariantProps<typeof bubbleVariants>[\"variant\"];\n</script>\n\n<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tvariant = \"default\",\n\t\talign = \"start\",\n\t\tappearance,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\tvariant?: BubbleVariant;\n\t\talign?: \"start\" | \"end\";\n\t\tappearance?: \"agent-user\" | \"agent-assistant\";\n\t} = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"bubble\"\n\tdata-variant={variant}\n\tdata-align={align}\n\tdata-appearance={appearance}\n\tclass={cn(\n\t\tappearance\n\t\t\t? \"data-[appearance=agent-user]:w-fit data-[appearance=agent-user]:max-w-[75%] data-[appearance=agent-user]:self-end data-[appearance=agent-assistant]:w-full *:data-[slot=bubble-content]:w-full *:data-[slot=bubble-content]:border-0 *:data-[slot=bubble-content]:text-[15px]/6 *:data-[slot=bubble-content]:text-[color:lch(20%_1_282)] dark:*:data-[slot=bubble-content]:text-foreground data-[appearance=agent-user]:*:data-[slot=bubble-content]:rounded-[8px] data-[appearance=agent-user]:*:data-[slot=bubble-content]:bg-[lch(96.5%_0_282)] dark:data-[appearance=agent-user]:*:data-[slot=bubble-content]:bg-[lch(13.861%_1.043_272)] data-[appearance=agent-user]:*:data-[slot=bubble-content]:px-3 data-[appearance=agent-user]:*:data-[slot=bubble-content]:py-2 data-[appearance=agent-assistant]:*:data-[slot=bubble-content]:rounded-none data-[appearance=agent-assistant]:*:data-[slot=bubble-content]:p-0 data-[appearance=agent-assistant]:*:data-[slot=bubble-content]:ps-2.5 [&>[data-slot=bubble-content]_a[href]:where(:not([data-slot]))]:wrap-anywhere [&>[data-slot=bubble-content]_a[href]:where(:not([data-slot]))]:font-[450] [&>[data-slot=bubble-content]_a[href]:where(:not([data-slot]))]:text-[color:lch(50%_80_288.43)] dark:[&>[data-slot=bubble-content]_a[href]:where(:not([data-slot]))]:text-[color:lch(80%_80_288.43)] [&>[data-slot=bubble-content]_a[href]:where(:not([data-slot]))]:no-underline [&>[data-slot=bubble-content]_a[href]:where(:not([data-slot]))]:transition-[color] [&>[data-slot=bubble-content]_a[href]:where(:not([data-slot]))]:duration-150 [&>[data-slot=bubble-content]_a[href]:where(:not([data-slot])):hover]:underline [&>[data-slot=bubble-content]_a[href]:where(:not([data-slot])):focus-visible]:underline [&>[data-slot=bubble-content]_a[href]:where(:not([data-slot])):focus-visible]:outline-none group/bubble relative flex min-w-0 flex-col\"\n\t\t\t: bubbleVariants({ variant }),\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
