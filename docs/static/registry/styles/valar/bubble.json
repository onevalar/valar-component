{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "bubble",
	"title": "Bubble 消息气泡",
	"type": "registry:ui",
	"description": "对话中的消息气泡，支持多种变体、对齐、分组和表情反应。",
	"devDependencies": [
		"tailwind-variants@^3.3.0"
	],
	"meta": {
		"valar": {
			"keywords": [
				"消息气泡",
				"bubble",
				"聊天",
				"chat",
				"对话",
				"reaction"
			],
			"whenToUse": [
				"聊天文字、引用回复、建议和反应的气泡外观"
			],
			"whenNotToUse": [
				{
					"case": "完整的消息行（头像、名字、时间、操作）",
					"use": "message"
				},
				{
					"case": "系统提示或日期分隔",
					"use": "marker"
				},
				{
					"case": "agent 的推理和工具调用步骤",
					"use": "trace"
				}
			],
			"accessibility": [
				"表情反应整组设 role=img 和描述性 aria-label，只读一次",
				"可点击的气泡用 child 渲染为真实 button 或 a",
				"变体颜色之外配合文字或对齐表达含义"
			],
			"responsive": [
				"气泡宽度随内容，最多占容器 80%；ghost 变体不限宽"
			],
			"related": [
				"message",
				"marker",
				"message-scroller"
			]
		}
	},
