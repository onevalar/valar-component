{
	"name": "@valar/svelte-ui",
	"version": "0.1.0",
	"private": true,
	"description": "Live workspace components generated from the Valar Svelte registry",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		"./theme.css": "./dist/valar/theme.css",
		"./hooks/*": "./dist/valar/hooks/*.svelte.ts",
		"./lib/*": "./dist/valar/lib/*.ts",
		"./styles/valar/*": "./dist/valar/ui/*/index.ts",
		"./themes/*": "./dist/*/theme.css",
		"./*": "./dist/valar/ui/*/index.ts"
	},
	"scripts": {
		"build": "node --import tsx scripts/build.ts",
		"dev": "node --import tsx scripts/build.ts --watch",
		"check": "svelte-check --fail-on-warnings --tsconfig tsconfig.json",
		"test": "pnpm build && node --import tsx --test test/*.test.ts"
	},
	"peerDependencies": {
		"svelte": "^5.57.2",
		"tailwindcss": "^4.3.3"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.0",
		"@internationalized/number": "^3.6.9",
		"@lucide/svelte": "^1.27.0",
		"@valar/svelte-primitives": "workspace:*",
		"bits-ui": "2.20.0",
		"cn": "^0.5.0",
		"embla-carousel-svelte": "^8.6.0",
		"formsnap": "^2.1.0",
		"layerchart": "^2.0.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"shiki": "^3.20.0",
		"svelte-sonner": "^1.2.0",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-variants": "^3.3.0",
		"tw-animate-css": "^1.4.0",
		"vaul-svelte": "1.0.0-next.7"
	},
	"devDependencies": {
		"@valar/svelte-cli": "workspace:*",
		"@valar/svelte-parity": "workspace:*",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.21.0",
		"typescript": "catalog:"
	}
}
