{
	"name": "@valar/vue-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Native Reka Vue components aligned with the shared Valar style",
	"files": [
		"dist",
		"LICENSE",
		"PROVENANCE.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.ts",
			"import": "./dist/index.ts"
		},
		"./theme.css": "./dist/theme.css",
		"./*": {
			"types": "./dist/ui/*/index.ts",
			"import": "./dist/ui/*/index.ts"
		}
	},
	"scripts": {
		"build": "node --import tsx scripts/build.ts",
		"check": "vue-tsc --noEmit -p tsconfig.json",
		"test": "node --import tsx --test test/*.test.ts"
	},
	"peerDependencies": {
		"vue": "^3.5.40",
		"tailwindcss": "^4.3.3"
	},
	"dependencies": {
		"@internationalized/date": "3.12.0",
		"@lucide/vue": "^1.28.0",
		"@unovis/ts": "^1.6.7",
		"@unovis/vue": "^1.6.7",
		"@vueuse/core": "^14.4.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.0",
		"reka-ui": "2.10.5",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@types/node": "^24",
		"@vue/compiler-sfc": "^3.5.40",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"vue": "^3.5.40",
		"vue-tsc": "^3.3.9"
	},
	"engines": {
		"node": ">=24.22.2 <25"
	}
}
